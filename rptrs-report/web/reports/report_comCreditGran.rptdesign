            <xml-property name="queryText"><![CDATA[SELECT btc.related_name AS related_name,-- 法人名称/自然人姓名
btc.ident_number AS ident_number,-- 统一社会信用代码/证件号码
btc.credit_start_date AS credit_start_date,-- 授信起始日期
btc.credit_end_date AS credit_end_date,-- 授 信终止日期
btc.trans_num AS trans_num, -- 授信编号
btc.credit_amount AS credit_amount,-- 授信额度
btc.bz AS bz, -- 授信币种
btc.tran_scope AS tran_scope, -- 授信业务范围
btc. remark AS remark,-- 备注
be.enclosureName AS enclosure_name-- 附件
FROM 
(
SELECT
GROUP_CONCAT(
DISTINCT (bte.related_name) SEPARATOR "---"
) AS enclosureName
FROM
bus_tra_enclosure bte
LEFT JOIN bus_tra_credit bc ON bc.pid = bte.enclosure_pid
WHERE
1=1
AND 
2=2
AND
3=3
AND 
4=4
AND bc.is_del = 1
AND bte.DELFLAG_ = 1
AND bc.business_type = bte.business_type
) AS be, 
bus_tra_credit btc 
WHERE
1=1
AND 
2=2
AND
3=3
AND 
4=4
AND btc.is_del =1
GROUP BY btc.related_name]]></xml-property>
