            <method name="beforeOpen"><![CDATA[importPackage(Packages.java.lang);
importPackage(Packages.java.text);
importPackage(Packages.org.apache.commons.lang);


//获取评估年度
//var nowYear = reportContext.getParameterValue("yearStr");
//this.queryText = StringUtils.replace(this.queryText,"_now_year_", nowYear);

var pStartDate = reportContext.getParameterValue("pStartDate");
var pEndDate = reportContext.getParameterValue("pEndDate");
this.queryText = StringUtils.replace(this.queryText,"_pStartDate_", pStartDate);
this.queryText = StringUtils.replace(this.queryText, "_pEndDate_", pEndDate);


//限制查询数据的部门
var celassessCode = reportContext.getParameterValue("assessCode");
var assessCode = new StringBuffer();
if(StringUtils.isNotBlank(celassessCode)){
	var array = new Array();
	array = celassessCode.split(',');
	for(var i=0;i<array.length;i++){
		if(array[i]=='0200'){
			array[i] = '02';
		}
		if(i > 0) assessCode.append(',');
		assessCode.append('\'' + array[i] + '\'');
	}
	this.queryText=StringUtils.replace(this.queryText,"2=2","a.assess_dept_ in ("+assessCode+")");
}
//数据权限控制
var unitId = reportContext.getParameterValue("mDak");
this.queryText = StringUtils.replace(this.queryText,"1=0", "a.assess_dept_ in (" + unitId + ")" );	

//机构
var mOrgCode = reportContext.getParameterValue("mOrgCode");
this.queryText = StringUtils.replace(this.queryText,"_current_org_", mOrgCode);	

//机构层级
var mUnitHierarchy = reportContext.getParameterValue("mUnitHierarchy");
if(mUnitHierarchy == 30){
	this.queryText = StringUtils.replace(this.queryText,"_HEAD_", "HEAD" );	
}else{
	this.queryText = StringUtils.replace(this.queryText,"_HEAD_", "BRANCH" );
}


System.out.println(this.queryText);
]]></method>
