            <method name="beforeOpen"><![CDATA[importPackage(Packages.java.lang);
importPackage(Packages.org.apache.commons.lang);

//获取机构
var assessCodes = reportContext.getParameterValue("assessCode");

if(StringUtils.isBlank(assessCodes)){//默认：全选
	;
}else if(StringUtils.indexOf(assessCodes, ",") > -1){//多选
	this.queryText = StringUtils.replace(this.queryText,"全选", '多选');	
}else{//单选
	this.queryText = StringUtils.replace(this.queryText,"\'全选\'", '');
	this.queryText = StringUtils.replace(this.queryText,"1 = 1", "unit_code_=\'" + assessCodes + "\'");
	//System.out.println(this.queryText);
}


]]></method>
