            <xml-property name="queryText"><![CDATA[with t1 as
 (select distinct b.assess_unit_,
                  b.assess_unitname_,
                  b.assess_dept_,
                  b.assess_deptname_,
                  b.process_id_,
                  b.process_name_,
                  c.ctrl_code_,
                  c.ctrl_desc_
    from bpa_process_info b, bpa_process_ctrl_info c
   where /*to_char(b.audit_date_, 'YYYY') = '_now_year_'*/
     b.audit_date_ between to_date('_pStartDate_', 'yyyy-mm-dd') and (case when '_pEndDate_' is null or '_pEndDate_' = '' then sysdate else to_date('_pEndDate_', 'yyyy-mm-dd') end)
     and b.process_head_branch_ = '_HEAD_'
     and b.assess_unit_ = '_current_org_'
     and b.version_status_ in ('C')
     and c.process_id_ = b.process_id_
     and c.ctrl_code_ in
         (select g.ctrl_code_
            from bpa_process_info f, bpa_process_ctrl_info g
           where /*to_char(f.audit_date_, 'yyyy') < '_now_year_'*/
             f.audit_date_ between to_date('_pStartDate_', 'yyyy-mm-dd') and (case when '_pEndDate_' is null or '_pEndDate_' = '' then sysdate else to_date('_pEndDate_', 'yyyy-mm-dd') end)
             /*and f.process_head_branch_ = '_HEAD_'
             and f.assess_unit_ = '_current_org_'*/
             and f.version_status_ in ('C')
             and f.process_id_ = g.process_id_)),
t2 as
 (select distinct b.assess_unit_,
                  b.assess_unitname_,
                  b.assess_dept_,
                  b.assess_deptname_,
                  b.process_id_,
                  b.process_name_,
                  c.step_code_,
                  c.step_name_,
                  c.risk_code_,
                  c.risk_desc_
    from bpa_process_info b, bpa_process_risk_info c
   where /*to_char(b.audit_date_, 'YYYY') = '_now_year_'*/
   b.audit_date_ between to_date('_pStartDate_', 'yyyy-mm-dd') and (case when '_pEndDate_' is null or '_pEndDate_' = '' then sysdate else to_date('_pEndDate_', 'yyyy-mm-dd') end)
     and b.process_head_branch_ = '_HEAD_'
     and b.assess_unit_ = '_current_org_'
     and b.version_status_ in ('C')
     and c.process_id_ = b.process_id_
     and c.risk_code_ in
         (select g.risk_code_
            from bpa_process_info f, bpa_process_risk_info g
           where /*to_char(f.audit_date_, 'yyyy') < '_now_year_'*/
           f.audit_date_ between to_date('_pStartDate_', 'yyyy-mm-dd') and (case when '_pEndDate_' is null or '_pEndDate_' = '' then sysdate else to_date('_pEndDate_', 'yyyy-mm-dd') end)
             /*and f.process_head_branch_ = '_HEAD_'
             and f.assess_unit_ = '_current_org_'*/
             and f.version_status_ in ('C')
             and f.process_id_ = g.process_id_))
select 
       assess_unit_,
       assess_unitname_,
       assess_dept_,
       assess_deptname_,
       sum(added_ctrl_num) added_ctrl_num,
       sum(added_risk_num) added_risk_num
from( 
select  a.assess_unit_,
        a.assess_unitname_,
        a.assess_dept_,
        a.assess_deptname_,
        count(distinct t1.ctrl_code_) added_ctrl_num,
        count(distinct t2.risk_code_) added_risk_num 
from bpa_process_info a
left join t1 on t1.process_id_ = a.process_id_ and t1.assess_unit_ = a.assess_unit_ and t1.assess_dept_ = a.assess_dept_
left join t2 on t2.process_id_ = a.process_id_ and t2.assess_unit_ = a.assess_unit_ and t2.assess_dept_ = a.assess_dept_
where 1=0 /*数据权限*/
    and 2=2 /*限制查询出数据部门*/
  group by a.assess_unit_, a.assess_unitname_,a.assess_dept_,a.assess_deptname_,a.process_id_
  having count(distinct t1.ctrl_code_) > 0 or count(distinct t2.risk_code_) > 0
) group by assess_unit_, assess_unitname_, assess_dept_, assess_deptname_]]></xml-property>
