            <xml-property name="queryText"><![CDATA[SELECT
	btc.related_name AS related_name,
	btc.ident_number AS ident_number,
	btc.important_trade AS important_trade,
	btc.internal_apply_no AS internal_apply_no,
	btc.apply_over_time AS apply_over_time,
	btc.apply_time AS apply_time,
	btc.credit_amount AS credit_amount,
	btc.credit_plan AS credit_plan,
	btc.remark AS remark
FROM
	bus_tra_credit btc
WHERE
		1 = 1
	AND 2 = 2
	AND 3 = 3
	AND 4 = 4 
	AND btc.is_insider = 0
	AND btc.DELFLAG_ = 1
;]]></xml-property>
        </oda-data-set>
