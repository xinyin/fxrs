            <xml-property name="queryText"><![CDATA[SELECT
	btc.related_name AS related_name,
	btc.ident_number AS ident_number,
	btc.internal_apply_no AS internal_apply_no,
	btc.contract_no AS contract_no,
	btc.contract_sign_date AS contract_sign_date,
	btc.credit_start_date AS credit_start_date,
	btc.credit_end_date AS credit_end_date,
	btc.business_type AS business_type,
	btc.tra_price_type AS tra_price_type,
	btc.rate_type AS rate_type,
	btc.tra_price AS tran_price,
	btc.float_rate_bench AS float_rate_bench,
	btc.float_interest_rate_spread AS float_interest_rate_spread,
	btc.float_rate_discount_rate AS float_rate_discount_rate,
	btc.tra_contract_amount AS tra_contract_amount,
	btc.bus_tra_balance AS bus_tra_balance,
	btc.pricing_strategy AS pricing_strategy,
	btc.remark AS remark
FROM
	bus_tra_credit btc
WHERE
	1 = 1
AND 2 = 2
AND 3 = 3
AND 4 = 4
AND btc.is_insider = 0
AND btc.DELFLAG_ = 1]]></xml-property>
