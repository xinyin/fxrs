            <xml-property name="queryText"><![CDATA[(
SELECT
	p.`name` AS name,
	-- 法人/自然人名称
	p.identify_number AS ident_number,
	-- 证件号码
	(
		-- 授信表中的各项贷款
		SELECT
			IFNULL(
				SUM(IFNULL(a.credit_amount, 0)),
				0
			)
		FROM
			bus_tra_credit a
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND a.tran_type = 'loan'
		AND a.pid=btc.pid
		AND a.DELFLAG_ = 1
	) AS loan,
	(
		-- 授信表中的债券投资
		SELECT
			SUM(IFNULL(b.credit_amount, 0))
		FROM
			bus_tra_credit b
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND b.tran_type = 'bondInvestment'
		AND b.pid=btc.pid
		AND b.DELFLAG_ = 1
	) AS bondInvestment,
	(
		-- 授信表中的特定目的的载体投资
		SELECT
			SUM(IFNULL(d.credit_amount, 0))
		FROM
			bus_tra_credit d
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND d.tran_type = 'investment'
		AND d.pid=btc.pid
		AND d.DELFLAG_ = 1
	) AS investment,
	(
		-- 授信表中的其他表内授信
		SELECT
			SUM(IFNULL(e.credit_amount, 0))
		FROM
			bus_tra_credit e
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND tran_type IN (
			'discount',
			'securitiesRepurchase',
			'tradeFinancing',
			'factoring',
			'overdraft',
			'borrow Money'
		)
		AND e.pid=btc.pid
		AND e.DELFLAG_ = 1
	) AS otherinnercredit,
	(
		-- 授信表中不可撤销的承诺及或有负债
		SELECT
			SUM(IFNULL(f.credit_amount, 0))
		FROM
			bus_tra_credit f
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND tran_type IN (
			'loanCommitment',
			'acceptance',
			'letterCredit',
			'letterGuarantee',
			'guarantee'
		)
		AND f.pid=btc.pid
		AND f.DELFLAG_ = 1
	) AS irrevocablecommitments,
	(
		-- 授信表中非保本
		SELECT
			SUM(IFNULL(g.credit_amount, 0))
		FROM
			bus_tra_credit g
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND tran_type = 'nonbreakevenfinancial'
		AND g.pid=btc.pid
		AND g.DELFLAG_ = 1
	) AS nonbreakevenfinancial,
	(
		-- 其他表外授信
		SELECT
			SUM(IFNULL(h.credit_amount, 0))
		FROM
			bus_tra_credit h
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND tran_type = 'commercialBankproducts'
		AND h.pid=btc.pid
		AND h.DELFLAG_ = 1
	) AS otheroutcredit,
	-- 资产转移  
	(
		SELECT
			SUM(IFNULL(bta.tran_amount, 0)) asset
		FROM
			bus_tra_asset AS bta
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND bta.rel_id=p.pid
		AND bta.DELFLAG_ = 1
	) AS asset_tran_amount,
	(
		-- 提供服务
		SELECT
			SUM(IFNULL(bts.tran_amount, 0)) provide
		FROM
			bus_tra_service AS bts
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND bts.rel_id=p.pid
		AND bts.DELFLAG_ = 1
	) AS provide_tran_amount,
	-- 其他
	(
		SELECT
			SUM(IFNULL(bto.tran_amount, 0)) other
		FROM
			bus_tra_other AS bto
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND bto.rel_id=p.pid
		AND bto.DELFLAG_ = 1
	) AS other_tran_amount,
	(
		-- 银行存单和国债
		SELECT
			SUM(IFNULL(i.national_debt, 0)) + SUM(IFNULL(i.bank_deposit, 0)) + SUM(
				IFNULL(i.securit_deposit, 0)
			)
		FROM
			bus_tra_credit i
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND i.pid=btc.pid
		AND i.DELFLAG_ = 1
	) AS depanddet
FROM
	bus_rel_psn p
INNER JOIN 
	bus_tra_credit btc ON btc.rel_id=p.pid
WHERE
	1 = 1
AND 2 = 2
AND 3 = 3
AND btc.DELFLAG_ = 1
GROUP BY
p.identify_number)
UNION ALL
(SELECT
	o.org_name AS name,
	-- 法人/自然人名称
	o.unisc_code AS ident_number,
	-- 证件号码
	(
		-- 授信表中的各项贷款
		SELECT
			IFNULL(
				SUM(IFNULL(a.credit_amount, 0)),
				0
			)
		FROM
			bus_tra_credit a
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND a.tran_type = 'loan'
		AND a.pid=o.pid
		AND a.DELFLAG_ = 1
	) AS loan,
	(
		-- 授信表中的债券投资
		SELECT
			SUM(IFNULL(b.credit_amount, 0))
		FROM
			bus_tra_credit b
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND b.tran_type = 'bondInvestment'
		AND b.pid=o.pid
		AND b.DELFLAG_ = 1
	) AS bondInvestment,
	(
		-- 授信表中的特定目的的载体投资
		SELECT
			SUM(IFNULL(d.credit_amount, 0))
		FROM
			bus_tra_credit d
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND d.tran_type = 'investment'
		AND d.pid=o.pid
		AND d.DELFLAG_ = 1
	) AS investment,
	(
		-- 授信表中的其他表内授信
		SELECT
			SUM(IFNULL(e.credit_amount, 0))
		FROM
			bus_tra_credit e
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND tran_type IN (
			'discount',
			'securitiesRepurchase',
			'tradeFinancing',
			'factoring',
			'overdraft',
			'borrow Money'
		)
		AND e.pid=o.pid
		AND e.DELFLAG_ = 1
	) AS otherinnercredit,
	(
		-- 授信表中不可撤销的承诺及或有负债
		SELECT
			SUM(IFNULL(f.credit_amount, 0))
		FROM
			bus_tra_credit f
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND tran_type IN (
			'loanCommitment',
			'acceptance',
			'letterCredit',
			'letterGuarantee',
			'guarantee'
		)
		AND f.pid=o.pid
		AND f.DELFLAG_ = 1
	) AS irrevocablecommitments,
	(
		-- 授信表中非保本
		SELECT
			SUM(IFNULL(g.credit_amount, 0))
		FROM
			bus_tra_credit g
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND tran_type = 'nonbreakevenfinancial'
		AND g.pid=o.pid
		AND g.DELFLAG_ = 1
	) AS nonbreakevenfinancial,
	(
		-- 其他表外授信
		SELECT
			SUM(IFNULL(h.credit_amount, 0))
		FROM
			bus_tra_credit h
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND tran_type = 'commercialBankproducts'
		AND h.pid=o.pid
		AND h.DELFLAG_ = 1
	) AS otheroutcredit,
	-- 资产转移  
	(
		SELECT
			SUM(IFNULL(bta.tran_amount, 0)) asset
		FROM
			bus_tra_asset AS bta
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND bta.rel_id=o.pid
		AND bta.DELFLAG_ = 1
	) AS asset_tran_amount,
	(
		-- 提供服务
		SELECT
			SUM(IFNULL(bts.tran_amount, 0)) provide
		FROM
			bus_tra_service AS bts
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND bts.rel_id=o.pid
		AND bts.DELFLAG_ = 1
	) AS provide_tran_amount,
	-- 其他
	(
		SELECT
			SUM(IFNULL(bto.tran_amount, 0)) other
		FROM
			bus_tra_other AS bto
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND bto.rel_id=o.pid
		AND bto.DELFLAG_ = 1
	) AS other_tran_amount,
	(
		-- 银行存单和国债
		SELECT
			SUM(IFNULL(i.national_debt, 0)) + SUM(IFNULL(i.bank_deposit, 0)) + SUM(
				IFNULL(i.securit_deposit, 0)
			)
		FROM
			bus_tra_credit i
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND i.pid=btc.pid
		AND i.DELFLAG_ = 1
	) AS depanddet
FROM
	bus_rel_org o
INNER JOIN 
	bus_tra_credit btc ON btc.rel_id=o.pid
WHERE
	1 = 1
AND 2 = 2
AND 3 = 3
AND btc.DELFLAG_ = 1
GROUP BY
o.unisc_code)
]]></xml-property>
            <xml-property name="designerValues"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<model:DesignValues xmlns:design="http://www.eclipse.org/datatools/connectivity/oda/design" xmlns:model="http://www.eclipse.org/birt/report/model/adapter/odaModel">
  <Version>2.0</Version>
  <design:ResultSets derivedMetaData="true">
    <design:resultSetDefinitions>
      <design:resultSetColumns>
        <design:resultColumnDefinitions>
          <design:attributes>
            <design:identifier>
              <design:name>name</design:name>
              <design:position>1</design:position>
            </design:identifier>
