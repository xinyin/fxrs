            <method name="beforeOpen"><![CDATA[importPackage(Packages.java.lang);
importPackage(Packages.org.apache.commons.lang);
var startTime = reportContext.getParameterValue("startTime"); //起始时间
var endTime = reportContext.getParameterValue("endTime");//结束时间
var manage_org = reportContext.getParameterValue("manage_org");//机构
if(startTime !=null &amp;&amp; !startTime.equals("") &amp;&amp; endTime!=null &amp;&amp; !endTime.equals("") ){
	this.queryText =this.queryText.replace("1=1", " date(approval_time) >= '" + startTime + "'" +" AND date(approval_time)<= '"+endTime+"'");
	if(manage_org!=null &amp;&amp; manage_org != ""){
		this.queryText =this.queryText.replace("2=2", " manage_org = '" + manage_org+"'");
	}
	System.out.println("--------------------"+this.queryText);
}else{
this.queryText = this.queryText.replace("3=3", " TO_DAYS( NOW( ) ) - TO_DAYS(approval_time) <= 1");
}]]></method>
