            <xml-property name="queryText"><![CDATA[SELECT
	(
		-- 表内外授信净额
		SELECT
			SUM(
				IFNULL(a.credit_amount, 0)
			) - SUM(IFNULL(a.national_debt, 0)) - SUM(IFNULL(a.bank_deposit, 0)) - SUM(
				IFNULL(a.securit_deposit, 0)
			)
		FROM
			bus_tra_credit a
		WHERE
			a.pid = btc.pid
		AND a.DELFLAG_ = 1
	) AS creditsum,
	(
		(
			(
				SELECT
					SUM(
						IFNULL(a.credit_amount, 0)
					)
				FROM
					bus_tra_credit a
				WHERE
					a.pid = btc.pid
				AND a.DELFLAG_ = 1
			) - (
				SELECT
					SUM(IFNULL(b1.national_debt, 0)) + SUM(IFNULL(b1.bank_deposit, 0)) + SUM(
						IFNULL(b1.securit_deposit, 0)
					)
				FROM
					bus_tra_credit b1
				WHERE
					b1.pid = btc.pid
				AND b1.DELFLAG_ = 1
			)
		) / (
			SELECT
				broi.net_captial
			FROM
				bus_root_org_info broi
		)
	) AS bili,
	(
		SELECT
			SUM(IFNULL(b1.national_debt, 0) + IFNULL(b1.bank_deposit, 0) + 
				IFNULL(b1.securit_deposit, 0))
			
		FROM
			bus_tra_credit b1
		 WHERE
			 b1.pid = btc.pid
		  AND b1.DELFLAG_ = 1
	) AS depanddet,
	(
		SELECT
			SUM(IFNULL(bta.transation_amount, 0)) asset
		FROM
			bus_tra_asset AS bta
		WHERE
			5 = 5
		AND 6 = 6
		AND 7 = 7
		AND 8 = 8
		AND bta.DELFLAG_ = 1
	) AS asset,
	(
		SELECT
			SUM(IFNULL(bts.transation_amount, 0)) provide
		FROM
			bus_tra_service AS bts
		WHERE
			5 = 5
		AND 6 = 6
		AND 7 = 7
		AND 8 = 8
		AND bts.DELFLAG_ = 1
	) AS provide,
	(
		SELECT
			SUM(IFNULL(bto.transation_amount, 0)) other
		FROM
			bus_tra_other AS bto
		WHERE
			5 = 5
		AND 6 = 6
		AND 7 = 7
		AND 8 = 8
		AND bto.DELFLAG_ = 1
	) AS other,
	(
		(
			SELECT
				SUM(IFNULL(bta.transation_amount, 0)) asset
			FROM
				bus_tra_asset AS bta
			WHERE
				5 = 5
			AND 6 = 6
			AND 7 = 7
			AND 8 = 8
			AND bta.DELFLAG_ = 1
		) + (
			SELECT
				SUM(IFNULL(bts.transation_amount, 0)) provide
			FROM
				bus_tra_service AS bts
			WHERE
				5 = 5
			AND 6 = 6
			AND 7 = 7
			AND 8 = 8
			AND bts.DELFLAG_ = 1
		) + (
			SELECT
				SUM(IFNULL(bto.transation_amount, 0)) other
			FROM
				bus_tra_other AS bto
			WHERE
				5 = 5
			AND 6 = 6
			AND 7 = 7
			AND 8 = 8
			AND bto.DELFLAG_ = 1
		)
	) AS sum
FROM
	bus_tra_credit btc
WHERE
	1 = 1
AND 2 = 2
AND 3 = 3
AND 4 = 4
LIMIT 1]]></xml-property>
