            <xml-property name="queryText"><![CDATA[SELECT
	(SELECT o.group_name FROM bus_rel_org o WHERE o.pid = btc.rel_id)AS Nname,
	btc.ident_number,
	IFNULL((
		SELECT
			brp.shareholding_proportion
		FROM
			bus_rel_psn brp
		WHERE
			brp.pid = btc.rel_id
	),0) AS shareholding_proportion,
sum((
		SELECT
			IFNULL(b1.credit_amount,0) - IFNULL(b1.national_debt,0)- IFNULL(b1.bank_deposit,0) - IFNULL(b1.securit_deposit,0)
			
		FROM
			bus_tra_credit b1
		WHERE
			b1.pid = btc.pid
		AND b1.DELFLAG_ = 1
		GROUP BY
			DATE(b1.tran_date)
	) )AS maxday,
	IFNULL((sum(
		(
			SELECT
				IFNULL(a.credit_amount, 0)
			FROM
				bus_tra_credit a
			WHERE
				a.business_type = 'loan'
			AND a.pid = btc.pid -- AND a.DELFLAG_ = 1
		)
	)),0) AS loan,
	-- 授信表中的债券投资boundInvestment
	IFNULL((sum(
		(
			SELECT
				IFNULL(b.credit_amount, 0)
			FROM
				bus_tra_credit b
			WHERE
				b.business_type = 'bondInvestment'
			AND b.pid = btc.pid
			AND b.DELFLAG_ = 1
		)
	)),0) AS bondInvestment,
	IFNULL((sum(
		(
			-- 授信表中的特定目的的载体投资investment
			SELECT
				IFNULL(d.credit_amount, 0)
			FROM
				bus_tra_credit d
			WHERE
				d.tran_type = 'investment'
			AND d.pid = btc.pid
			AND d.DELFLAG_ = 1
		)
	)),0) AS investment,
	IFNULL((sum(
		(
			-- 授信表中的其他表内授信otherinnercredit
			SELECT
				IFNULL(e.credit_amount, 0)
			FROM
				bus_tra_credit e
			WHERE
				tran_type IN (
					'discount',
					'securitiesRepurchase',
					'tradeFinancing',
					'factoring',
					'overdraft',
					'borrow Money'
				)
			AND e.pid = btc.pid
			AND e.DELFLAG_ = 1
		)
	)),0) AS otherinnercredit,
	IFNULL((sum(
		(
			-- 授信表中不可撤销的承诺及或有负债irrevocablecommitments
			SELECT
				IFNULL(f.credit_amount, 0)
			FROM
				bus_tra_credit f
			WHERE
				tran_type IN (
					'loanCommitment',
					'acceptance',
					'letterCredit',
					'letterGuarantee',
					'guarantee'
				)
			AND f.pid = btc.pid
			AND f.DELFLAG_ = 1
		)
	)),0) AS irrevocablecommitments,
	IFNULL((sum(
		(
			-- 授信表中非保本nonbreakevenfinancial
			SELECT
				IFNULL(g.credit_amount, 0)
			FROM
				bus_tra_credit g
			WHERE
				tran_type = 'nonbreakevenfinancial'
			AND g.pid = btc.pid
			AND g.DELFLAG_ = 1
		) )),0)AS nonbreakevenfinancial,
		IFNULL((sum(
			(
				-- 其他表外授信otheroutcredit
				SELECT
					IFNULL(h.credit_amount, 0)
				FROM
					bus_tra_credit h
				WHERE
					tran_type = 'commercialBankproducts'
				AND h.pid = btc.pid
				AND h.DELFLAG_ = 1
			)
		)),0) AS otheroutcredit,
			-- 银行存单和国债depanddet	
IFNULL((SUM((SELECT IFNULL(btc.national_debt, 0)+IFNULL(btc.bank_deposit, 0)+IFNULL(btc.securit_deposit, 0)))),0)AS depanddet,
		(
			(
				SELECT
					broi.net_captial
				FROM
					bus_root_org_info broi
			)
		) AS proportion -- 资本净额proportion
	FROM
		bus_tra_credit btc
WHERE
	1 = 1
AND 2 = 2
AND 3 = 3
AND 4 = 4
AND btc.rel_type = 'ORG'
	GROUP BY
		btc.related_name
 LIMIT 10]]></xml-property>
