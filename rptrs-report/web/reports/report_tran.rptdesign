                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
	`btc`.`tran_type` AS `tran_type`,
	`sdi`.`ITEM_LABEL_` AS `tran_name`,
	`btc`.`business_type` AS `business_type`,
	count(
		(
			(
				(`btc`.`is_del` = 1)
				AND (`btc`.`status` = 'E')
			)
			OR NULL
		)
	) AS `appQuant`,
	-- 审批通过率数量
	count(((`btc`.`is_del` = 1) OR NULL)) AS `applicaNum`,
	-- 申请数量
	concat(
		round(
			(
				(
					count(
						(
							(
								(`btc`.`is_del` = 1)
								AND (`btc`.`status` = 'E')
							)
							OR NULL
						)
					) / count(((`btc`.`is_del` = 1) OR NULL))
				) * 1
			),
			2
		),
		'%'
	) AS `apprRateFac`,
	-- 审批通过率 
	concat(
		round(
			(
				(
					sum(`btc`.`credit_amount`) / sum_amount.tran_amount -- 求总的交易金额
				) * 1
			),
			2
		),
		'%'
	) AS `tranAmount`,
	concat(
		round(
			(
				(
					count(((`btc`.`is_del` = 1) OR NULL)) / sum_applinum.b -- 求申请总数
				) * 1
			),
			2
		),
		'%'
	) AS `appliPro`
FROM
	bus_tra_credit btc,
	sys_dict_item sdi,
	(
		SELECT
			SUM(a.appliNum) AS b
		FROM
			(
				SELECT
					count(*) AS `appliNum`
				FROM
					`bus_tra_asset`
				WHERE
					`is_del` = 1
				AND 1 = 1
				UNION ALL
					SELECT
						count(*)
					FROM
						`bus_tra_credit`
					WHERE
						`is_del` = 1
					AND 1 = 1
					UNION ALL
						SELECT
							count(*)
						FROM
							`bus_tra_other`
						WHERE
							`is_del` = 1
						AND 1 = 1
						UNION ALL
							SELECT
								count(*)
							FROM
								`bus_tra_service`
							WHERE
								`is_del` = 1
							AND 1 = 1
			) a
	) AS sum_applinum,
	(
		SELECT
			SUM(c.tran_amount) AS tran_amount
		FROM
			(
				SELECT
					sum(`credit_amount`) AS `tran_amount`
				FROM
					`bus_tra_credit`
				WHERE
					`is_del` = 1
				AND 1 = 1
				UNION ALL
					SELECT
						sum(`tran_amount`)
					FROM
						`bus_tra_asset`
					WHERE
						`is_del` = 1
					AND 1 = 1
					UNION ALL
						SELECT
							sum(`tran_amount`)
						FROM
							`bus_tra_service`
						WHERE
							`is_del` = 1
						AND 1 = 1
						UNION ALL
							SELECT
								sum(`tran_amount`)
							FROM
								`bus_tra_other`
							WHERE
								`is_del` = 1
							AND 1 = 1
			) c
	) AS sum_amount
WHERE
	sdi.ITEM_VALUE_ = btc.tran_type
AND (btc.is_del = 1)
AND 1 = 1
GROUP BY
	btc.tran_type]]></xml-property>
