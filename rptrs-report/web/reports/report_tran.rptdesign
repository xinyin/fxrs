            <xml-property name="queryText"><![CDATA[SELECT
	`bts`.`tran_type` AS `tran_type`,
	`sdi`.`ITEM_LABEL_` AS `tran_name`,
	`bts`.`business_type` AS `business_type`,
	count(
		(
			(
				(`bts`.`is_del` = 1)
				AND (`bts`.`status` = 'E')
			)
			OR NULL
		)
	) AS `appQuant`,
	count(((`bts`.`is_del` = 1) OR NULL)) AS `applicaNum`,
	concat(
		round(
			(
				(
					count(
						(
							(
								(`bts`.`is_del` = 1)
								AND (`bts`.`status` = 'E')
							)
							OR NULL
						)
					) / count(((`bts`.`is_del` = 1) OR NULL))
				) * 1
			),
			2
		),
		'%'
	) AS `apprRateFac`,
	concat(
		round(
			(
				(
					sum(`bts`.`tran_amount`) / sum_amount.tran_amount
				) * 1
			),
			2
		),
		'%'
	) AS `tranAmount`,
	concat(
		round(
			(
				(
					count(((`bts`.`is_del` = 1) OR NULL)) / sum_applinum.b
				) * 1
			),
			2
		),
		'%'
	) AS `appliPro`
FROM
	bus_tra_service bts
LEFT JOIN sys_dict_item sdi ON sdi.ITEM_VALUE_ = bts.tran_type,
 (
	SELECT
		SUM(a.appliNum) AS b
	FROM
		(
			SELECT
				count(*) AS `appliNum`
			FROM
				`bus_tra_asset`
			WHERE
				`is_del` = 1
			AND 1 = 1
			UNION ALL
				SELECT
					count(*)
				FROM
					`bus_tra_credit`
				WHERE
					`is_del` = 1
				AND 1 = 1
				UNION ALL
					SELECT
						count(*)
					FROM
						`bus_tra_other`
					WHERE
						`is_del` = 1
					AND 1 = 1
					UNION ALL
						SELECT
							count(*)
						FROM
							`bus_tra_service`
						WHERE
							`is_del` = 1
						AND 1 = 1
		) a
) AS sum_applinum,
 (
	SELECT
		SUM(c.tran_amount) AS tran_amount
	FROM
		(
			SELECT
				sum(`credit_amount`) AS `tran_amount`
			FROM
				`bus_tra_credit`
			WHERE
				`is_del` = 1
			AND 1 = 1
			UNION ALL
				SELECT
					sum(`tran_amount`)
				FROM
					`bus_tra_asset`
				WHERE
					`is_del` = 1
				AND 1 = 1
				UNION ALL
					SELECT
						sum(`tran_amount`)
					FROM
						`bus_tra_service`
					WHERE
						`is_del` = 1
					AND 1 = 1
					UNION ALL
						SELECT
							sum(`tran_amount`)
						FROM
							`bus_tra_other`
						WHERE
							`is_del` = 1
						AND 1 = 1
		) c
) AS sum_amount
WHERE
	(bts.is_del = 1)
AND 1 = 1
GROUP BY
	bts.tran_type]]></xml-property>
