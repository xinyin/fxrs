                    <property name="position">8</property>
                    <property name="name">appliPro</property>
                    <property name="nativeName">appliPro</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
	`bta`.`tran_type` AS `tran_type`,
	`sdi`.`ITEM_LABEL_` AS `tran_name`,
	`bta`.`business_type` AS `business_type`,
	count(
		(
			(
				(`bta`.`is_del` = 1)
				AND (`bta`.`status` = 'E')
			)
			OR NULL
		)
	) AS `appQuant`,
	-- 申请通过的数量
	count(((`bta`.`is_del` = 1) OR NULL)) AS `applicaNum`,
	-- 新增交易数量
	concat(
		round(
			(
				(
					count(
						(
							(
								(`bta`.`is_del` = 1)
								AND (`bta`.`status` = 'E')
							)
							OR NULL
						)
					) / count(((`bta`.`is_del` = 1) OR NULL))
				) * 1
			),
			2
		),
		'%'
	) AS `apprRateFac`,
	-- 申请通过的率
	concat(
		round(
			(
				(
					sum(`bta`.`tran_amount`) / sum_amount.tran_amount -- -- 求总交易金额
				) * 1
			),
			2
		),
		'%'
	) AS `tranAmount`,
	-- 交易金额占比
	concat(
		round(
			(
				(
					count(((`bta`.`is_del` = 1) OR NULL)) / sum_applinum.b -- 新增交易总数量
				) * 1
			),
			2
		),
		'%'
	) AS `appliPro` -- 新增交易数量占比
FROM
	bus_tra_asset bta
LEFT JOIN sys_dict_item sdi ON sdi.ITEM_VALUE_ = bta.tran_type,
 (
	SELECT
		SUM(a.appliNum) AS b
	FROM
		(
			SELECT
				count(*) AS `appliNum`
			FROM
				`bus_tra_asset`
			WHERE
				`is_del` = 1
			AND 1 = 1
			UNION ALL
				SELECT
					count(*)
				FROM
					`bus_tra_credit`
				WHERE
					`is_del` = 1
				AND 1 = 1
				UNION ALL
					SELECT
						count(*)
					FROM
						`bus_tra_other`
					WHERE
						`is_del` = 1
					AND 1 = 1
					UNION ALL
						SELECT
							count(*)
						FROM
							`bus_tra_service`
						WHERE
							`is_del` = 1
						AND 1 = 1
		) a
) AS sum_applinum,
 (
	SELECT
		SUM(c.tran_amount) AS tran_amount
	FROM
		(
			SELECT
				sum(`credit_amount`) AS `tran_amount`
			FROM
				`bus_tra_credit`
			WHERE
				`is_del` = 1
			AND 1 = 1
			UNION ALL
				SELECT
					sum(`tran_amount`)
				FROM
					`bus_tra_asset`
				WHERE
					`is_del` = 1
				AND 1 = 1
				UNION ALL
					SELECT
						sum(`tran_amount`)
					FROM
						`bus_tra_service`
					WHERE
						`is_del` = 1
					AND 1 = 1
					UNION ALL
						SELECT
							sum(`tran_amount`)
						FROM
							`bus_tra_other`
						WHERE
							`is_del` = 1
						AND 1 = 1
		) c
) AS sum_amount
WHERE
	(bta.is_del = 1)
AND 1 = 1
GROUP BY
	bta.tran_type]]></xml-property>
