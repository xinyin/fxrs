            <property name="dataSource">Data Source</property>
            <method name="open"><![CDATA[importPackage(Packages.java.lang);
importPackage(Packages.org.apache.commons.lang);
var startTime = reportContext.getParameterValue("startTime"); //起始时间
var endTime = reportContext.getParameterValue("endTime");//结束时间
var tenantId = reportContext.getParameterValue("tenantId");
count = 0;
cf= new Packages.com.yzj.controller.Report_alltraController();
c=cf.selectAll(startTime,endTime,tenantId);
//c=cf.selectByAll(startTime,endTime);]]></method>
            <method name="fetch"><![CDATA[if (count <= c.size() - 1){
    row["NAME"] = c.get(count).getNAME();
    row["number"] = c.get(count).getNumber();
    row["ii"] = c.get(count).getIi();
    row["a"] = c.get(count).getA();
    row["b"] = c.get(count).getB();
    row["c"] = c.get(count).getC();
    row["d"] = c.get(count).getD();
  
    count ++;
    return true;
}
return false;]]></method>
        </script-data-set>
