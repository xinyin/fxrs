            <xml-property name="queryText"><![CDATA[(
 SELECT
  btc.related_name AS related_name,
  btc.identify_type AS identify_type,
  btc.ident_number AS ident_number,
  btc.business_type AS business_type,
  btc.tran_date AS tran_date,
  btc.credit_amount AS tran_amount
 FROM
  bus_tra_credit btc
 WHERE
  1 = 1
 AND 2 = 2
 AND 3 = 3
 AND 4 = 4
 AND 5 = 5
 AND 6 = 6
 AND 7 = 7
 AND 8 = 8
 AND btc.is_insider = 1
)
UNION ALL
 (
  SELECT
   bto.related_name AS related_name,
   bto.identlfy_type AS identlfy_type,
   bto.ident_number AS ident_number,
   bto.business_type AS business_type,
   bto.tran_date AS tran_date,
   bto.tran_amount AS tran_amount
  FROM
   bus_tra_other bto
  WHERE
   9 = 9
  AND 10 = 10
  AND 11 = 11
  AND 12 = 12
  AND 13 = 13
  AND 14 = 14
  AND 15 = 15
  AND 16 = 16
  AND bto.business_type IN (
   'INfinamarket&amp;derivatran',
   'INfinarrang',
   'INtransasset',
   'INtranfixedeasset',
   'INmanagserplan',
   'INreinsplan',
   'INservicecharge',
   'INAgencytransa',
   'INcrosharehold'
  )
  AND bto.is_insider = 1
 )]]></xml-property>
