            <method name="beforeOpen"><![CDATA[importPackage(Packages.java.lang);
importPackage(Packages.org.apache.commons.lang);
var relatedName = reportContext.getParameterValue("relatedName");//内部人名称
var identifyType = reportContext.getParameterValue("identifyType");//证件类型
var identNumber = reportContext.getParameterValue("identNumber");//证件号吗
var startTime = reportContext.getParameterValue("startTime"); //起始时间
var endTime = reportContext.getParameterValue("endTime");//结束时间
var businessType = reportContext.getParameterValue("businessType"); //业务类型
var manage_org = reportContext.getParameterValue("manage_org");//机构
//System.out.println("--------------------"+startTime+"---------"+endTime);
if(startTime !=null &amp;&amp; !startTime.equals("") &amp;&amp; endTime!=null &amp;&amp; !endTime.equals("") ){
	//this.queryText = this.queryText +" AND  (approval_time) >= '"+startTime+"'"+" AND (approval_time)<= '"+endTime+"'";
	this.queryText =this.queryText.replace("1=1", " related_name '" + relatedName + "'");
	this.queryText =this.queryText.replace("9=9", " related_name '" + relatedName + "'");
	this.queryText =this.queryText.replace("2=2", " identify_type '" + identifyType + "'");
	this.queryText =this.queryText.replace("10=10", " identify_type '" + identifyType + "'");
	this.queryText =this.queryText.replace("3=3", " ident_number '" + identNumber + "'");
	this.queryText =this.queryText.replace("11=11", " ident_number '" + identNumber + "'");
	this.queryText =this.queryText.replace("4=4", " credit_start_date >= '" + startTime + "'" +" AND (credit_start_date)<= '"+endTime+"'");
	this.queryText =this.queryText.replace("12=12", " business_start_time >= '" + startTime + "'" +" AND (business_start_time)<= '"+endTime+"'");
	if(businessType!=null &amp;&amp; businessType != ""){
		this.queryText =this.queryText.replace("6=6", " business_type = '" + businessType+"'");
		this.queryText =this.queryText.replace("14=14", " business_type = '" + businessType+"'");
	}
	//System.out.println("--------------------"+this.queryText);
	if(manage_org!=null &amp;&amp; manage_org != ""){
		this.queryText =this.queryText.replace("7=7", " manage_org = '" + manage_org+"'");
		this.queryText =this.queryText.replace("15=15", " manage_org = '" + manage_org+"'");
	}
	
	System.out.println("--------------------"+this.queryText);
}else{
this.queryText = this.queryText.replace("8=8", " TO_DAYS( NOW( ) ) - TO_DAYS(credit_start_date) <= 1");
this.queryText = this.queryText.replace("16=16", " TO_DAYS( NOW( ) ) - TO_DAYS(business_start_time) <= 1");
}]]></method>
