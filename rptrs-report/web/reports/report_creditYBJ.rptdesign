            <xml-property name="queryText"><![CDATA[SELECT
	`sdi`.`ITEM_LABEL_` AS `tranName`,
	-- 交易名称
	SUM(DISTINCT(btc.rel_id) OR NULL) AS relNum,
	-- 关联方交户数
	COUNT(btc.is_del = 1 OR NULL) AS tranNum,
	-- 交易笔数
	SUM(btc.credit_amount) AS sum_Amount,
	-- 交易总额
-- 	CONCAT(
		ROUND(
			(
				(
					(SUM(btc.is_del = 1 OR NULL)) / (SUM(btc.rel_id OR NULL))
				) * 1
			),
			2
		)
-- 		'%'
-- 	) 
AS avg_rel,
	-- 单户平均交易笔数
	ROUND(
		(
			(
				(SUM(btc.credit_amount)) / (SUM(btc.is_del = 1 OR NULL))
			) * 1
		),
		2
	) AS avg_tranum,
	-- 单笔平均交易金额
	MAX(btc.credit_amount) AS tra_maxAmount,
	-- 单笔最大交易金额
  	MAX(a.sumA) rel_maxAmount,
	-- 单户最大交易金额
	COUNT(
		DISTINCT(btc.rel_id)
		AND btc.related_tran_type ='重大关联交易'
		OR NULL
	) AS rela_ral,
	-- 重大关联交易户数
	COUNT(
		(btc.related_tran_type ='重大关联交易')
		OR NULL
	) AS rela_tran -- 重大关联交易笔数
FROM
	sys_dict_item sdi,
	bus_tra_credit btc



  LEFT JOIN (
  	SELECT
  		SUM(credit_amount) AS sumA,
  		tran_type AS tt
  	FROM
  		bus_tra_credit
  	WHERE
  		 1=1
  	AND is_del = 1
  	AND regulator_ybj = 1
  	GROUP BY
  		tran_type,
  		rel_id
  ) a ON a.tt = btc.tran_type


WHERE
	 1=1
AND btc.is_del = 1
AND sdi.ITEM_VALUE_ = btc.tran_type
AND regulator_ybj = 1
GROUP BY
	btc.tran_type]]></xml-property>
