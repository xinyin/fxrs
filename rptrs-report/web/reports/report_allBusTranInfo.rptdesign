            <xml-property name="queryText"><![CDATA[(
	SELECT
		p.`name` AS NAME,
		-- 法人/自然人名称
		p.identify_number AS ident_number,
		(
			SELECT
				(
					SUM(b1.bus_tra_balance) - SUM(b1.national_debt) - SUM(b1.bank_deposit) - SUM(b1.securit_deposit)
				) AS jing
			FROM
				bus_tra_credit b1
			WHERE
				b1.pid = btc.pid
			AND b1.DELFLAG_ = 1
			GROUP BY
				DATE(b1.tran_date)
		) AS maxday,
		-- 证件号码
		(
			-- 授信表中的各项贷款
			SELECT
				IFNULL(
					SUM(
						IFNULL(a.bus_tra_balance, 0)
					),
					0
				)
			FROM
				bus_tra_credit a
			WHERE
				a.tran_type = 'loan'
			AND a.pid = btc.pid
			AND a.DELFLAG_ = 1
		) AS loan,
		(
			-- 授信表中的债券投资
			SELECT
				SUM(
					IFNULL(b.bus_tra_balance, 0)
				)
			FROM
				bus_tra_credit b
			WHERE
				b.tran_type = 'bondInvestment'
			AND b.pid = btc.pid
			AND b.DELFLAG_ = 1
		) AS bondInvestment,
		(
			-- 授信表中的特定目的的载体投资
			SELECT
				SUM(
					IFNULL(d.bus_tra_balance, 0)
				)
			FROM
				bus_tra_credit d
			WHERE
				d.tran_type = 'investment'
			AND d.pid = btc.pid
			AND d.DELFLAG_ = 1
		) AS investment,
		(
			-- 授信表中的其他表内授信
			SELECT
				SUM(
					IFNULL(e.bus_tra_balance, 0)
				)
			FROM
				bus_tra_credit e
			WHERE
				e.tran_type IN (
					'discount',
					'securitiesRepurchase',
					'tradeFinancing',
					'factoring',
					'overdraft',
					'borrow Money'
				)
			AND e.pid = btc.pid
			AND e.DELFLAG_ = 1
		) AS otherinnercredit,
		(
			-- 授信表中不可撤销的承诺及或有负债
			SELECT
				SUM(
					IFNULL(f.bus_tra_balance, 0)
				)
			FROM
				bus_tra_credit f
			WHERE
				f.tran_type IN (
					'loanCommitment',
					'acceptance',
					'letterCredit',
					'letterGuarantee',
					'guarantee'
				)
			AND f.pid = btc.pid
			AND f.DELFLAG_ = 1
		) AS irrevocablecommitments,
		(
			-- 授信表中非保本
			SELECT
				SUM(
					IFNULL(g.bus_tra_balance, 0)
				)
			FROM
				bus_tra_credit g
			WHERE
				g.tran_type = 'nonbreakevenfinancial'
			AND g.pid = btc.pid
			AND g.DELFLAG_ = 1
		) AS nonbreakevenfinancial,
		(
			-- 其他表外授信
			SELECT
				SUM(
					IFNULL(h.bus_tra_balance, 0)
				)
			FROM
				bus_tra_credit h
			WHERE
				h.tran_type = 'commercialBankproducts'
			AND h.pid = btc.pid
			AND h.DELFLAG_ = 1
		) AS otheroutcredit,
		-- 资产转移  
		(
			SELECT
				SUM(
					IFNULL(bta.transation_amount, 0)
				) asset
			FROM
				bus_tra_asset AS bta
			WHERE
				5 = 5
			AND 6 = 6
			AND 7 = 7
			AND 8 = 8
			AND bta.rel_id = p.pid
			AND bta.DELFLAG_ = 1
		) AS asset_tran_amount,
		(
			-- 提供服务
			SELECT
				SUM(
					IFNULL(bts.transation_amount, 0)
				) provide
			FROM
				bus_tra_service AS bts
			WHERE
				5 = 5
			AND 6 = 6
			AND 7 = 7
			AND 8 = 8
			AND bts.rel_id = p.pid
			AND bts.DELFLAG_ = 1
		) AS provide_tran_amount,
		-- 其他
		(
			SELECT
				SUM(
					IFNULL(bto.transation_amount, 0)
				) other
			FROM
				bus_tra_other AS bto
			WHERE
				5 = 5
			AND 6 = 6
			AND 7 = 7
			AND 8 = 8
			AND bto.rel_id = p.pid
			AND bto.DELFLAG_ = 1
		) AS other_tran_amount,
		(
			-- 银行存单和国债
			SELECT
				SUM(IFNULL(i.national_debt, 0)) + SUM(IFNULL(i.bank_deposit, 0)) + SUM(
					IFNULL(i.securit_deposit, 0)
				)
			FROM
				bus_tra_credit i
			WHERE
				i.pid = btc.pid
			AND i.DELFLAG_ = 1
		) AS depanddet,
		(
			SELECT
				broi.net_captial
			FROM
				bus_root_org_info broi
		) AS proportion -- 资本净额proportion
	FROM
		bus_rel_psn p
	LEFT JOIN bus_tra_credit btc ON btc.rel_id = p.pid
	WHERE
		1 = 1
	AND 2 = 2
	AND 3 = 3
	AND 4 = 4
	AND btc.DELFLAG_ = 1
	AND P.DELFLAG_ = 1
	GROUP BY
		p.identify_number
)
UNION ALL
	(
		SELECT
			o.org_name AS NAME,
			-- 法人/自然人名称
			o.unisc_code AS ident_number,
(
		SELECT
			(
				SUM(b1.bus_tra_balance) - SUM(b1.national_debt) - SUM(b1.bank_deposit) - SUM(b1.securit_deposit)
			) AS jing
		FROM
			bus_tra_credit b1
		WHERE
			b1.pid = btc.pid
		AND b1.DELFLAG_ = 1
		GROUP BY
			DATE(b1.tran_date)
	) AS maxday,
			-- 证件号码
			(
				-- 授信表中的各项贷款
				SELECT
					IFNULL(
						SUM(
							IFNULL(a.bus_tra_balance, 0)
						),
						0
					)
				FROM
					bus_tra_credit a
				WHERE
					a.tran_type = 'loan'
				AND a.pid = o.pid
				AND a.DELFLAG_ = 1
			) AS loan,
			(
				-- 授信表中的债券投资
				SELECT
					SUM(
						IFNULL(b.bus_tra_balance, 0)
					)
				FROM
					bus_tra_credit b
				WHERE
					b.tran_type = 'bondInvestment'
				AND b.pid = o.pid
				AND b.DELFLAG_ = 1
			) AS bondInvestment,
			(
				-- 授信表中的特定目的的载体投资
				SELECT
					SUM(
						IFNULL(d.bus_tra_balance, 0)
					)
				FROM
					bus_tra_credit d
				WHERE
					d.tran_type = 'investment'
				AND d.pid = o.pid
				AND d.DELFLAG_ = 1
			) AS investment,
			(
				-- 授信表中的其他表内授信
				SELECT
					SUM(
						IFNULL(e.bus_tra_balance, 0)
					)
				FROM
					bus_tra_credit e
				WHERE
					e.tran_type IN (
						'discount',
						'securitiesRepurchase',
						'tradeFinancing',
						'factoring',
						'overdraft',
						'borrow Money'
					)
				AND e.pid = o.pid
				AND e.DELFLAG_ = 1
			) AS otherinnercredit,
			(
				-- 授信表中不可撤销的承诺及或有负债
				SELECT
					SUM(
						IFNULL(f.bus_tra_balance, 0)
					)
				FROM
					bus_tra_credit f
				WHERE
					f.tran_type IN (
						'loanCommitment',
						'acceptance',
						'letterCredit',
						'letterGuarantee',
						'guarantee'
					)
				AND f.pid = o.pid
				AND f.DELFLAG_ = 1
			) AS irrevocablecommitments,
			(
				-- 授信表中非保本
				SELECT
					SUM(
						IFNULL(g.bus_tra_balance, 0)
					)
				FROM
					bus_tra_credit g
				WHERE
					g.tran_type = 'nonbreakevenfinancial'
				AND g.pid = o.pid
				AND g.DELFLAG_ = 1
			) AS nonbreakevenfinancial,
			(
				-- 其他表外授信
				SELECT
					SUM(
						IFNULL(h.bus_tra_balance, 0)
					)
				FROM
					bus_tra_credit h
				WHERE
					h.tran_type = 'commercialBankproducts'
				AND h.pid = o.pid
				AND h.DELFLAG_ = 1
			) AS otheroutcredit,
			-- 资产转移  
			(
				SELECT
					SUM(
						IFNULL(bta.transation_amount, 0)
					) asset
				FROM
					bus_tra_asset AS bta
				WHERE
					5 = 5
				AND 6 = 6
				AND 7 = 7
				AND 8 = 8
				AND bta.rel_id = o.pid
				AND bta.DELFLAG_ = 1
			) AS asset_tran_amount,
			(
				-- 提供服务
				SELECT
					SUM(
						IFNULL(bts.transation_amount, 0)
					) provide
				FROM
					bus_tra_service AS bts
				WHERE
					5 = 5
				AND 6 = 6
				AND 7 = 7
				AND 8 = 8
				AND bts.rel_id = o.pid
				AND bts.DELFLAG_ = 1
			) AS provide_tran_amount,
			-- 其他
			(
				SELECT
					SUM(
						IFNULL(bto.transation_amount, 0)
					) other
				FROM
					bus_tra_other AS bto
				WHERE
					5 = 5
				AND 6 = 6
				AND 7 = 7
				AND 8 = 8
				AND bto.rel_id = o.pid
				AND bto.DELFLAG_ = 1
			) AS other_tran_amount,
			(
				-- 银行存单和国债
				SELECT
					SUM(IFNULL(i.national_debt, 0)) + SUM(IFNULL(i.bank_deposit, 0)) + SUM(
						IFNULL(i.securit_deposit, 0)
					)
				FROM
					bus_tra_credit i
				WHERE
					i.pid = btc.pid
				AND i.DELFLAG_ = 1
			) AS depanddet,
			(
				SELECT
					broi.net_captial
				FROM
					bus_root_org_info broi
			) AS proportion -- 资本净额proportion
		FROM
			bus_rel_org o
		INNER JOIN bus_tra_credit btc ON btc.rel_id = o.pid
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND 4 = 4
		AND btc.DELFLAG_ = 1
		GROUP BY
			o.unisc_code
	);
]]></xml-property>
        </oda-data-set>
    </data-sets>
