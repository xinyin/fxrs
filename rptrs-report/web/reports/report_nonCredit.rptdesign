            <xml-property name="queryText"><![CDATA[(
	SELECT
		bta.related_name AS related_name,
		bta.ident_number AS ident_number,
		bta.important_trade AS important_trade,
		bta.contract_no AS contract_no,
		bta.contract_sign_date AS contract_sign_date,
		bta.business_start_time AS business_start_time,
		bta.business_end_time AS business_end_time,
		bta.tran_type AS tran_type,
		bta.business_type AS business_type,
		bta.tran_amount AS tran_amount,
		bta.tran_price AS tran_price,
		bta.tran_target AS tran_target,
		bta.pricing_strategy AS pricing_strategy,
		bta.remark AS remark
	FROM
		bus_tra_asset bta
	WHERE
		1 = 1
	AND 2 = 2
	AND 3 = 3
	AND 4 = 4 
	AND bta.is_insider = 0
	AND bta.DELFLAG_ = 1
)
UNION ALL
	(
		SELECT
			bts.related_name AS related_name,
			bts.ident_number AS ident_number,
			bts.important_trade AS important_trade,
			bts.contract_no AS contract_no,
			bts.contract_sign_date AS contract_sign_date,
			bts.business_start_time AS business_start_time,
			bts.business_end_time AS business_end_time,
			bts.tran_type AS tran_type,
			bts.business_type AS business_type,
			bts.tran_amount AS tran_amount,
			bts.tran_price AS tran_price,
			bts.tran_target AS tran_target,
			bts.pricing_strategy AS pricing_strategy,
			bts.remark AS remark
		FROM
			bus_tra_service bts
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND 4 = 4 
		AND bts.is_insider = 0
		AND bts.DELFLAG_ = 1
	)
UNION ALL
	(
		SELECT
			bto.related_name AS related_name,
			bto.ident_number AS ident_number,
			bto.important_trade AS important_trade,
			bto.contract_no AS contract_no,
			bto.contract_sign_date AS contract_sign_date,
			bto.business_start_time AS business_start_time,
			bto.business_end_time AS business_end_time,
			bto.tran_type AS tran_type,
			bto.business_type AS business_type,
			bto.tran_amount AS tran_amount,
			bto.tran_price AS tran_price,
			bto.tran_target AS tran_target,
			bto.pricing_strategy AS pricing_strategy,
			bto.remark AS remark
		FROM
			bus_tra_other bto
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND 4 = 4 
		AND bto.is_insider = 0
		AND bto.DELFLAG_ = 1
	)]]></xml-property>
        </oda-data-set>
