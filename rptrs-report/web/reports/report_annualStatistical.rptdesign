    row["GENERAL_REL_TRAN_AMOUNT"] = c.get(count).getGENERAL_REL_TRAN_AMOUNT();
    row["TRAN_AMOUNT"] = c.get(count).getTRAN_AMOUNT();
    count ++;
    return true;
}
return false;]]></method>
