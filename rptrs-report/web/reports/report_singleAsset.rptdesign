            <xml-property name="queryText"><![CDATA[SELECT 
bta.related_name AS related_name,-- 法人名称/自然人姓名
bta.ident_number AS ident_number,-- 统一社会信用代码/证件号码
bta.contract_no AS contract_no,-- 合同编号
bta.contract_sign_date AS contract_sign_date, -- 合同签署日期
bta.tran_date AS tran_date, -- 交易发生日期
bta.business_type AS business_type, -- 交易类型
bta.tran_target AS tran_target, -- 交易标的
bta.tran_price AS tran_price, -- 交易价格
bta.tran_amount AS tran_amount, -- 交易金额
bta.pricing_strategy AS pricing_strategy, -- 定价政策
bta. remark AS remark,-- 备注
be.enclosureName AS enclosure_name-- 附件
FROM  
(
SELECT
GROUP_CONCAT(
DISTINCT (bte.related_name) SEPARATOR "---"
) AS enclosureName
FROM
bus_tra_enclosure bte
LEFT JOIN bus_tra_asset ba ON ba.pid = bte.enclosure_pid
WHERE
1=1
AND 
2=2
AND
3=3
AND 
4=4
AND ba.is_del = 1
AND bte.DELFLAG_ = 1
AND ba.business_type = bte.business_type
) AS be, 
bus_tra_asset bta 
WHERE 
1=1
AND 
2=2
AND
3=3
AND 
4=4
AND bta.is_del =1
GROUP BY bta.related_name]]></xml-property>
