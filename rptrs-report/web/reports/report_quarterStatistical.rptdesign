            <property name="dataSource">Data Source</property>
            <method name="open"><![CDATA[importPackage(Packages.java.lang);
importPackage(Packages.org.apache.commons.lang);
var year = reportContext.getParameterValue("year"); //年份
var quarter = reportContext.getParameterValue("quarter"); //季度
var code = reportContext.getParameterValue("code");//机构码
count = 0;
System.out.println("************set begin**************");
cf=new Packages.com.yzj.controller.Report_quarterController();
System.out.println("************set**************");
c=cf.selectInvestment(year, quarter, code);
System.out.println("************set end**************");]]></method>
            <method name="fetch"><![CDATA[if (count <= c.size() -1) {
    System.out.println("************set fetch**************");
    row["GENERAL_REL_TRAN_NUMBER"] = c.get(count).getGENERAL_REL_TRAN_NUMBER();
    row["MAJOR_REL_TRAN_NUMBER"] = c.get(count).getMAJOR_REL_TRAN_NUMBER();
    row["MAJOR_REL_TRAN_AMOUNT"] = c.get(count).getMAJOR_REL_TRAN_AMOUNT();
    row["GENERAL_REL_TRAN_AMOUNT"] = c.get(count).getGENERAL_REL_TRAN_AMOUNT();
    row["TRAN_AMOUNT"] = c.get(count).getTRAN_AMOUNT();
    System.out.println("************set fetch end**************");
    count++;
    return true;
}
return false;]]></method>
            <method name="close"><![CDATA[System.out.println("************set close**************");
System.out.println("************set close end**************");]]></method>
        </script-data-set>
