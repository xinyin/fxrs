            <xml-property name="queryText"><![CDATA[(
	SELECT
		p.`name`,
		p.identify_type,
		p.identify_number,
		(
			-- 表内外授信
			SELECT
				SUM(
					IFNULL(a.bus_tra_balance, 0)
				)
			FROM
				bus_tra_credit a
			WHERE
				a.pid = c.pid
			AND a.DELFLAG_ = 1
		) AS credit,
		(
			SELECT
				SUM(
					IFNULL(b.tran_amount, 0)
				)
			FROM
				bus_tra_other b
			WHERE
				5 = 5
			AND 6 = 6
			AND 7 = 7
			AND 8 = 8
			AND tran_type = 'INfinamarket&amp;derivatran'
			AND b.rel_id = p.pid
			AND b.DELFLAG_ = 1
		) AS jinrong,
		(
			SELECT
				SUM(IFNULL(bc.tran_amount, 0))
			FROM
				bus_tra_other bc
			WHERE
				5 = 5
			AND 6 = 6
			AND 7 = 7
			AND 8 = 8
			AND tran_type = 'INfinarrang'
			AND bc.rel_id = p.pid
			AND bc.DELFLAG_ = 1
		) AS licai,
		(
			SELECT
				SUM(IFNULL(d.tran_amount, 0))
			FROM
				bus_tra_other d
			WHERE
				5 = 5
			AND 6 = 6
			AND 7 = 7
			AND 8 = 8
			AND tran_type = 'INtransasset'
			AND d.rel_id = p.pid
			AND d.DELFLAG_ = 1
		) AS xindai,
		(
			SELECT
				SUM(IFNULL(e.tran_amount, 0))
			FROM
				bus_tra_other e
			WHERE
				5 = 5
			AND 6 = 6
			AND 7 = 7
			AND 8 = 8
			AND tran_type = 'INtranfixedeasset'
			AND e.rel_id = p.pid
			AND e.DELFLAG_ = 1
		) AS guding,
		(
			SELECT
				SUM(IFNULL(f.tran_amount, 0))
			FROM
				bus_tra_other f
			WHERE
				5 = 5
			AND 6 = 6
			AND 7 = 7
			AND 8 = 8
			AND tran_type = 'INmanagserplan'
			AND f.rel_id = p.pid
			AND f.DELFLAG_ = 1
		) AS guanli,
		(
			SELECT
				SUM(IFNULL(g.tran_amount, 0))
			FROM
				bus_tra_other g
			WHERE
				5 = 5
			AND 6 = 6
			AND 7 = 7
			AND 8 = 8
			AND tran_type = 'INreinsplan'
			AND g.rel_id = p.pid
			AND g.DELFLAG_ = 1
		) AS zaibao,
		(
			SELECT
				SUM(IFNULL(h.tran_amount, 0))
			FROM
				bus_tra_other h
			WHERE
				5 = 5
			AND 6 = 6
			AND 7 = 7
			AND 8 = 8
			AND tran_type = 'INservicecharge'
			AND h.rel_id = p.pid
			AND h.DELFLAG_ = 1
		) AS fuwu,
		(
			SELECT
				SUM(IFNULL(i.tran_amount, 0))
			FROM
				bus_tra_other i
			WHERE
				5 = 5
			AND 6 = 6
			AND 7 = 7
			AND 8 = 8
			AND tran_type = 'INAgencytransa'
			AND i.rel_id = p.pid
			AND i.DELFLAG_ = 1
		) AS daili,
		(
			SELECT
				SUM(IFNULL(j.tran_amount, 0))
			FROM
				bus_tra_other j
			WHERE
				5 = 5
			AND 6 = 6
			AND 7 = 7
			AND 8 = 8
			AND tran_type = 'INcrosharehold'
			AND j.rel_id = p.pid
			AND j.DELFLAG_ = 1
		) AS jiaocha
	FROM
		bus_tra_credit c
	JOIN bus_rel_psn p ON p.pid = c.rel_id
	LEFT JOIN bus_rel r ON p. NAME = r.from_memo
	AND r.to_memo = '成都农商行'
	WHERE
		1 = 1
	AND 2 = 2
	AND 3 = 3
	AND 4 = 4
	AND c.rel_type = '1'
	AND c.is_insider = 1
	AND r.DELFLAG_ = '1'
	AND p.DELFLAG_ = '1'
	GROUP BY
		c.related_name,
		c.ident_number
)
UNION ALL
	(
		SELECT
			o.org_name,
			o.identify_type,
			o.unisc_code AS identify_number,
			(
				-- 表内外授信
				SELECT
					SUM(IFNULL(a.credit_amount, 0))
				FROM
					bus_tra_credit a
				WHERE
					a.pid = c.pid
				AND a.DELFLAG_ = 1
			) AS credit,
			(
				SELECT
					SUM(IFNULL(b.tran_amount, 0))
				FROM
					bus_tra_other b
				WHERE
					5 = 5
				AND 6 = 6
				AND 7 = 7
				AND 8 = 8
				AND tran_type = 'INfinamarket&amp;derivatran'
				AND b.rel_id = o.pid
				AND b.DELFLAG_ = 1
			) AS jinrong,
			(
				SELECT
					SUM(IFNULL(bc.tran_amount, 0))
				FROM
					bus_tra_other bc
				WHERE
					5 = 5
				AND 6 = 6
				AND 7 = 7
				AND 8 = 8
				AND tran_type = 'INfinarrang'
				AND bc.rel_id = o.pid
				AND bc.DELFLAG_ = 1
			) AS licai,
			(
				SELECT
					SUM(IFNULL(d.tran_amount, 0))
				FROM
					bus_tra_other d
				WHERE
					5 = 5
				AND 6 = 6
				AND 7 = 7
				AND 8 = 8
				AND tran_type = 'INtransasset'
				AND d.rel_id = o.pid
				AND d.DELFLAG_ = 1
			) AS xindai,
			(
				SELECT
					SUM(IFNULL(e.tran_amount, 0))
				FROM
					bus_tra_other e
				WHERE
					5 = 5
				AND 6 = 6
				AND 7 = 7
				AND 8 = 8
				AND tran_type = 'INtranfixedeasset'
				AND e.rel_id = o.pid
				AND e.DELFLAG_ = 1
			) AS guding,
			(
				SELECT
					SUM(IFNULL(f.tran_amount, 0))
				FROM
					bus_tra_other f
				WHERE
					5 = 5
				AND 6 = 6
				AND 7 = 7
				AND 8 = 8
				AND tran_type = 'INmanagserplan'
				AND f.rel_id = o.pid
				AND f.DELFLAG_ = 1
			) AS guanli,
			(
				SELECT
					SUM(IFNULL(g.tran_amount, 0))
				FROM
					bus_tra_other g
				WHERE
					5 = 5
				AND 6 = 6
				AND 7 = 7
				AND 8 = 8
				AND tran_type = 'INreinsplan'
				AND g.rel_id = o.pid
				AND g.DELFLAG_ = 1
			) AS zaibao,
			(
				SELECT
					SUM(IFNULL(h.tran_amount, 0))
				FROM
					bus_tra_other h
				WHERE
					5 = 5
				AND 6 = 6
				AND 7 = 7
				AND 8 = 8
				AND tran_type = 'INservicecharge'
				AND h.rel_id = o.pid
				AND h.DELFLAG_ = 1
			) AS fuwu,
			(
				SELECT
					SUM(IFNULL(i.tran_amount, 0))
				FROM
					bus_tra_other i
				WHERE
					5 = 5
				AND 6 = 6
				AND 7 = 7
				AND 8 = 8
				AND tran_type = 'INAgencytransa'
				AND i.rel_id = o.pid
				AND i.DELFLAG_ = 1
			) AS daili,
			(
				SELECT
					SUM(IFNULL(j.tran_amount, 0))
				FROM
					bus_tra_other j
				WHERE
					5 = 5
				AND 6 = 6
				AND 7 = 7
				AND 8 = 8
				AND tran_type = 'INcrosharehold'
				AND j.rel_id = o.pid
				AND j.DELFLAG_ = 1
			) AS jiaocha
		FROM
			bus_tra_credit c
		JOIN bus_rel_org o ON o.pid = c.rel_id
		LEFT JOIN bus_rel r ON o.org_name = r.from_memo
		AND r.to_memo = '成都农商行'
		WHERE
			1 = 1
		AND 2 = 2
		AND 3 = 3
		AND 4 = 4
		AND c.rel_type = '2'
		AND c.is_insider = 1
		AND r.DELFLAG_ = '1'
		AND o.DELFLAG_ = '1'
		GROUP BY
			o.org_name,
			o.unisc_code
	);]]></xml-property>
            <xml-property name="designerValues"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<model:DesignValues xmlns:design="http://www.eclipse.org/datatools/connectivity/oda/design" xmlns:model="http://www.eclipse.org/birt/report/model/adapter/odaModel">
  <Version>2.0</Version>
  <design:ResultSets derivedMetaData="true">
    <design:resultSetDefinitions>
      <design:resultSetColumns>
        <design:resultColumnDefinitions>
          <design:attributes>
            <design:identifier>
              <design:name>name</design:name>
              <design:position>1</design:position>
            </design:identifier>
            <design:nativeDataTypeCode>12</design:nativeDataTypeCode>
            <design:precision>500</design:precision>
            <design:scale>0</design:scale>
            <design:nullability>Nullable</design:nullability>
            <design:uiHints>
              <design:displayName>name</design:displayName>
            </design:uiHints>
          </design:attributes>
          <design:usageHints>
            <design:label>name</design:label>
            <design:formattingHints>
              <design:displaySize>500</design:displaySize>
            </design:formattingHints>
          </design:usageHints>
        </design:resultColumnDefinitions>
        <design:resultColumnDefinitions>
          <design:attributes>
            <design:identifier>
              <design:name>identify_type</design:name>
              <design:position>2</design:position>
            </design:identifier>
