            <property name="dataSource">Data Source</property>
            <method name="open"><![CDATA[importPackage(Packages.java.lang);
importPackage(Packages.org.apache.commons.lang);
var startTime = reportContext.getParameterValue("startTime"); //起始时间
var endTime = reportContext.getParameterValue("endTime");//结束时间
var tenantId = reportContext.getParameterValue("tenantId");
count = 0;
cf= new Packages.com.yzj.controller.Report_fundsController();
c=cf.selectByAll(startTime,endTime,tenantId);
//c=cf.selectByAll(startTime,endTime);]]></method>
            <method name="fetch"><![CDATA[if (count <= c.size() - 1){
    row["REL_NAME"] = c.get(count).getREL_NAME();
    row["REL_NUMBER"] = c.get(count).getREL_NUMBER();
    row["MAJOR_TRADE"] = c.get(count).getMAJOR_TRADE();
    row["CONTRACT_NO"] = c.get(count).getCONTRACT_NO();
    row["TRAN_DATE"] = c.get(count).getTRAN_DATE();
    row["BUS_START_TIME"] = c.get(count).getBUS_START_TIME();
    row["BUS_END_TIME"] = c.get(count).getBUS_END_TIME();
    row["INVESTMENT_TYPE"] = c.get(count).getINVESTMENT_TYPE();
    row["INVESTED_ENTERPRISES"] = c.get(count).getINVESTED_ENTERPRISES();
    row["INVESTMENT_RATIO"] = c.get(count).getINVESTMENT_RATIO();
    row["FINANCIAL_ASSSTS_NUM"] = c.get(count).getFINANCIAL_ASSSTS_NUM();
    row["FINANCIAL_PRO_SCALE"] = c.get(count).getFINANCIAL_PRO_SCALE();
    row["UNDERLYING_ASSET"] = c.get(count).getUNDERLYING_ASSET();
    row["UNDER_IS_REL"] = c.get(count).getUNDER_IS_REL();
    row["UNDER_INVOLVE_REL"] = c.get(count).getUNDER_INVOLVE_REL();
    row["UNDER_REL"] = c.get(count).getUNDER_REL();
    row["BUS_MODEL"] = c.get(count).getBUS_MODEL();
    row["EARNINGS_EXPECTAIONS"] = c.get(count).getEARNINGS_EXPECTAIONS();
    row["INVESTMENT_ALLOCATION"] = c.get(count).getINVESTMENT_ALLOCATION();
    row["LOSS_SHARE"] = c.get(count).getLOSS_SHARE();
    row["TRADE_AMOUNT"] = c.get(count).getTRADE_AMOUNT();
    row["TRADE_PRICE"] = c.get(count).getTRADE_PRICE();
    row["TRADE_SUBJECT"] = c.get(count).getTRADE_SUBJECT();   
  	row["PRICING_POLICY"] = c.get(count).getPRICING_POLICY();
    row["REMARK"] = c.get(count).getREMARK();
    row["FINANCIAL_ASSSTS_TYPE"] = c.get(count).getFINANCIAL_ASSSTS_TYPE();
    count ++;
    return true;
}
return false;]]></method>
