<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yzj.jep.app.bus.mapper.LegalInviolableRightsMapper">
    <!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.yzj.jep.app.bus.model.LegalInviolableRights" id="busLegalInviolableRightsMap">
        <result property="pid" column="pid"/>
        <result property="legalPid" column="legal_pid"/>
        <result property="legalRegCode" column="legal_reg_code"/>
        <result property="name" column="name_"/>
        <result property="isShare" column="is_share"/>
        <result property="holderScale" column="holder_scale"/>
        <result property="activeTime" column="active_time"/>
        <result property="invalidTime" column="invalid_time"/>
        <result property="tenantId" column="TENANT_ID_"/>
        <result property="createdById" column="CREATED_BY_ID_"/>
        <result property="createdByName" column="CREATED_BY_NAME_"/>
        <result property="createdTime" column="CREATED_TIME_"/>
        <result property="delflag" column="DELFLAG_"/>
        <result property="displayOrder" column="DISPLAY_ORDER_"/>
        <result property="modifiedById" column="MODIFIED_BY_ID_"/>
        <result property="modifiedByName" column="MODIFIED_BY_NAME_"/>
        <result property="modifiedTime" column="MODIFIED_TIME_"/>
        <result property="version" column="VERSION_"/>
        <result property="comment" column="comment"/>
    </resultMap>
    <select id="searchByPid" resultMap="busLegalInviolableRightsMap" parameterType="integer">
        select
        pid
        ,legal_pid
        ,legal_reg_code
        ,name
        ,is_share
        ,holder_scale
        ,comment
        from bus_legal_inviolable_rights where legal_pid=#{pid}
    </select>
</mapper>

