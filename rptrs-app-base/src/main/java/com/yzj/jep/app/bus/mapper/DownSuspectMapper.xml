<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yzj.jep.app.bus.mapper.DownSuspectMapper">
    <resultMap id="DownSuspectMap" type="com.yzj.jep.app.bus.model.suspect.DownSuspect">
        <id column="pid" property="pid"/>
        <result column="from_pid" property="fromPid"/>
        <result column="to_pid" property="toPid"/>
        <result column="name_" property="name"/>
        <result column="shareholders_code" property="shareholdersCode"/>
        <result column="identify_type" property="identifyType"/>
        <result column="unisc_code" property="uniscCode"/>
        <result column="rel_type" property="relType"/>
        <result column="relation" property="relation"/>
        <result column="shareholding_ratio" property="shareholdingRatio"/>
        <result column="hole_share_amount" property="holeShareAmount"/>
    </resultMap>
    <select id="getDownPsnInfo" resultMap="DownSuspectMap">
        select a.name_
        ,a.shareholders_code
        ,a.identify_type
        ,a.identify_number as unisc_code
        ,b.rel_type
        ,b.relation
        ,b.shareholding_ratio
        ,a.hole_share_amount
        from bus_rel_psn a
        LEFT join bus_rel b
        on a.pid=b.to_pid
        and b.from_type='PSN'
        where b.from_pid=7782
    </select>
</mapper>