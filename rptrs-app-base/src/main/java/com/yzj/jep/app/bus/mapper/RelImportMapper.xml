<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yzj.jep.app.bus.mapper.RelImportMapper">
    <update id="clearTable">
         truncate table  bus_rel_import ;
    </update>

    <select id="selectCountByToIdentifyNumber" parameterType="java.lang.String" resultType="int">
        select count(1) from  bus_rel_import where from_identify_number = #{identifyNumber}
    </select>
</mapper>
