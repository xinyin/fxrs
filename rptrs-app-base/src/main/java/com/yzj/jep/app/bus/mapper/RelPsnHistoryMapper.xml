    <select id="queryRecordNumberData" resultMap="relPsnMap">
        SELECT h.*
        FROM bus_rel_psn_history h
                 RIGHT JOIN
             (SELECT h1.record_number,
                     h1.identify_number,
                     MAX(h1.PID) pid
              FROM (SELECT * FROM bus_rel_psn_history ORDER BY CREATED_TIME_ DESC) h1,
                   (SELECT record_number
                    FROM bus_rel_psn_history
                    WHERE record_number IS NOT NULL
                      AND date_format(CREATED_TIME_, '%Y-%m-%d') = #{createTime}
                    GROUP BY record_number) queryNum
              WHERE h1.record_number = queryNum.record_number
                AND date_format(h1.CREATED_TIME_, '%Y-%m-%d') <![CDATA[ <= ]]> #{createTime}
                AND h1.record_type != '3'
        AND h1.PID
        AND NOT EXISTS (
        SELECT
        h2.PID
        FROM
        bus_rel_psn_history h2
        LEFT JOIN (
        SELECT
        t1.record_number,t1.identify_number,MAX(t1.CREATED_TIME_) CREATED_TIME_
        FROM
        ( SELECT * FROM bus_rel_psn_history h ORDER BY CREATED_TIME_ DESC ) t1,
        ( SELECT record_number FROM bus_rel_psn_history WHERE record_number IS NOT NULL AND date_format( CREATED_TIME_, '%Y-%m-%d' ) = #{createTime} GROUP BY record_number ) queryNum
                  WHERE
                  t1.record_number = queryNum.record_number
                AND date_format( CREATED_TIME_
                  , '%Y-%m-%d' ) <![CDATA[ <= ]]> #{createTime}
                AND t1.record_type = '3'
                  GROUP BY
                  t1.record_number
                  , t1.identify_number
                  ) h3 ON h2.identify_number = h3.identify_number
                  WHERE
                  h2.record_number = h3.record_number
                AND h2.CREATED_TIME_ <![CDATA[ < ]]> h3.CREATED_TIME_
                AND h1.pid = h2.PID
                  )
              GROUP BY
                  h1.record_number,
                  h1.identify_number) h4 ON h.PID = h4.PID
    </select>
    <select id="recordNumber" resultType="java.lang.String">
        SELECT distinct
        record_number
        FROM bus_rel_psn_history
        WHERE record_number is NOT NULL
        ORDER BY record_number DESC
    </select>
    <select id="queryRecordNumber" resultMap="relPsnMap">
        SELECT *
        FROM
        bus_rel_psn_history
        where DELFLAG_ ='1' and
        record_number=#{recordNumber}
        <if test="recordType != null">
            AND  record_type = #{recordType}
        </if>
        ORDER BY IDENTIFY_NUMBER,CREATED_TIME_ DESC
    </select>
</mapper>

