<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yzj.jep.app.bus.mapper.LegalPersonMapper">
    <resultMap type="com.yzj.jep.app.bus.model.LegalPerson" id="busLegalPersonMap">
        <result property="pid" column="pid"/>
        <result property="regCode" column="reg_code"/>
        <result property="orignalOrg" column="orignal_org"/>
        <result property="orignalOrgName" column="orignal_org_name"/>
        <result property="orgName" column="org_name"/>
        <result property="orgType" column="org_type"/>
        <result property="domesticOrForeign" column="domestic_or_foreign"/>
        <result property="uniscCode" column="unisc_code"/>
        <result property="regCapital" column="reg_capital"/>
        <result property="regCapitalCurrency" column="reg_capital_currency"/>
        <result property="businessScope" column="business_scope"/>
        <result property="status" column="status"/>
        <result property="legalPerson" column="legal_person"/>
        <result property="regAddress" column="reg_address"/>
        <result property="reportVersion" column="report_version"/>
        <result property="validStatus" column="valid_status"/>
        <result property="isReported" column="is_reported"/>
        <result property="activeTime" column="active_time"/>
        <result property="invalidTime" column="invalid_time"/>
        <result property="tenantId" column="TENANT_ID_"/>
        <result property="createdById" column="CREATED_BY_ID_"/>
        <result property="createdByName" column="CREATED_BY_NAME_"/>
        <result property="createdTime" column="CREATED_TIME_"/>
        <result property="delflag" column="DELFLAG_"/>
        <result property="displayOrder" column="DISPLAY_ORDER_"/>
        <result property="bodyType" column="body_type"/>
        <result property="modifiedById" column="MODIFIED_BY_ID_"/>
        <result property="modifiedByName" column="MODIFIED_BY_NAME_"/>
        <result property="modifiedTime" column="MODIFIED_TIME_"/>
        <result property="version" column="VERSION_"/>
        <result property="identifyType" column="identify_type"/>
        <result property="identifyNumber" column="identify_number"/>
        <result property="commitStatus" column="commit_status"/>
    </resultMap>
    <select id="search" resultMap="busLegalPersonMap">
        SELECT
        *
        from
        bus_legal_person
        where 1=1
        <if test="legalPerson.orignalOrgName !=null and legalPerson.orignalOrgName !=''">
            and orignal_org_name=#{orignalOrgName}
        </if>
        <if test="legalPerson.identifyType !=null and legalPerson.identifyType !=''">
            and identify_type=#{identifyType}
        </if>
        <if test="legalPerson.identifyNumber !=null and legalPerson.identifyNumber !=''">
            and identify_number=#{identifyNumber}
        </if>
    </select>
</mapper>