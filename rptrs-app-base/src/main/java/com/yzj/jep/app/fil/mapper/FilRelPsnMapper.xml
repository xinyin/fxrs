    </resultMap>
    <select id="selectRelPsnInformation" resultType="com.yzj.jep.app.fil.model.FilRelPsnVo">
        SELECT b.fil_num,
        b.name,
        b.residential_address residentialAddress,
        b.birthdate,
        b.identify_type identifyType,
        b.identify_number identifyNumber,
        b.pid,r.pid relId,
        r.rel_category relCategory,
        r.rel_category_sub relCategorySub,
        r.rel_status relStatus,
        r.regulator regulator,
        r.isValid,
        r.effectiveDate,
        r.ineffectiveDate,
        r.relStatement,
        r.rel_predicate as predicate
        FROM fil_rel_psn b JOIN fil_rel r ON r.from_pid = b.pid WHERE r.from_type = 'PSN' AND r.to_type = 'PSN' AND
        r.to_pid = #{pid}
        Order BY r.MODIFIED_TIME_ DESC
    </select>
    <select id="selectDownRelPsnInformation" resultType="com.yzj.jep.app.fil.model.FilRelPsnVo">

        SELECT b.fil_num
        b.name,
        b.residential_address residentialAddress,
        b.birthdate,
        b.identify_type identifyType,
        b.identify_number identifyNumber,
        b.pid,r.pid relId,
        r.rel_category relCategory,
        r.rel_category_sub relCategorySub,
        r.rel_status relStatus,
        r.regulator regulator,
        r.isValid,
        r.effectiveDate,
        r.ineffectiveDate,
        r.relStatement
        FROM fil_rel_psn b
        JOIN fil_rel r
        ON r.to_pid = b.pid
        WHERE r.from_type = 'PSN' AND r.to_type = 'PSN' AND r.rel_status='00' AND r.from_pid = #{pid}
        Order BY r.MODIFIED_TIME_ DESC
    </select>
    <select id="selectFilRelPsnByfalgPid" parameterType="String" resultType="com.yzj.jep.app.fil.model.FilRelPsn">

        SELECT * FROM fil_rel_psn where flag_pid = #{flagPid} and DELFLAG_ = 1 order by pid


    </select>

    <select id="selectFilRelPsnByfalgPidDesc"  parameterType="com.yzj.jep.app.fil.model.FilRelPsn" resultMap="relPsnMap">
        SELECT * FROM fil_rel_psn
        where flag_pid = #{flagPid}
          and DELFLAG_ = 1
        order by pid desc
    </select>
</mapper>

