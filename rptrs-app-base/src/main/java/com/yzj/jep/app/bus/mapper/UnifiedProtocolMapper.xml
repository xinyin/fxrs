    <select id="queryByConditions"  resultMap="baseResultMap">
        select
        ser.contract_date contract_date,
        ser.tran_name tran_name,
        ser.rel_trade_amount Contract_Amount,
        aa.contractNo CONTRACT_NO,
        ser.REL_NAME,
        ser.REL_TYPE ,
        ser.REL_NUMBER ,
        aa.pracTradeAmount prac_trade_amount
        from
        (
        select
        contract_no contractNo,
        SUM(CAST(prac_trade_amount as decimal)) pracTradeAmount
        from
        ins_tra_service
        where
        delflag_ = '1'
        and status = '6'
        and contract_date is not null
        and
        is_agreement = '1'
        group by
        contract_no) aa
        left join
        ins_tra_service ser on
        ser.contract_no = aa.contractNo
        where
        ser.delflag_ = '1'
        and ser.contract_date is not
        null
        and ser.is_agreement = '1'
        and ser.status = '6'
        <if test="param.contractNo!=null and param.contractNo!=''">
            and ser.CONTRACT_NO = #{param.contractNo}
        </if>
        <if test="param.beginQuarter!=null and param.beginQuarter!=''">
            and contract_date <![CDATA[
                    >=
                ]]> #{param.beginQuarter}
        </if>
        <if test="param.endQuarter!=null and param.endQuarter!=''">
            and contract_date <![CDATA[
                    <=
                ]]> #{param.endQuarter}
        </if>
        <if test="param.year!=null and param.year!=''">
            and contract_date like #{param.year}
        </if>
        union all
        select
        ser.contract_date contractDate,
        ser.tran_name tranName,
        ser.rel_trade_amount contractAmount,
        aa.contractNo
        contractNo,
        ser.REL_NAME,
        ser.REL_TYPE ,
        ser.REL_NUMBER ,
        aa.pracTradeAmount pracTradeAmount
        from
        (
        select
        contract_no contractNo,
        SUM(CAST(prac_trade_amount as decimal)) pracTradeAmount
        from
        ins_tra_business
        where
        delflag_ = '1'
        and status = '6'
        and contract_date is not null
        and
        is_agreement = '1'
        group by
        contract_no) aa
        left join
        ins_tra_business ser on
        ser.contract_no = aa.contractNo
        where
        ser.delflag_ = '1'
        and ser.contract_date is not
        null
        and ser.is_agreement = '1'
        and ser.status = '6'
        <if test="param.contractNo!=null and param.contractNo!=''">
            and ser.CONTRACT_NO = #{param.contractNo}
        </if>
        <if test="param.beginQuarter!=null and param.beginQuarter!=''">
            and contract_date <![CDATA[
                    >=
                ]]> #{param.beginQuarter}
        </if>
        <if test="param.endQuarter!=null and param.endQuarter!=''">
            and contract_date <![CDATA[
                    <=
                ]]> #{param.endQuarter}
        </if>
        <if test="param.year!=null and param.year!=''">
            and contract_date like #{param.year}
        </if>
</select>

    <select id="getAgreementNum" resultType="java.lang.String">
    SELECT
    a.trade_Agreement_Number AS agreement_Num
    FROM(SELECT trade_Agreement_Number FROM ins_tra_interest
    WHERE is_Agreement = '1'
    UNION
    SELECT trade_agreement_number FROM ins_tra_service
    WHERE is_Agreement = '1'
    UNION
    SELECT trade_agreement_number FROM ins_tra_business
    WHERE is_Agreement = '1')AS a
    </select>


    <select id="getAgreementTotalDetail" resultMap="baseResultMap">
    SELECT
    sum( a.REL_TRADE_AMOUNT ) REL_TRADE_AMOUNT
    FROM(
        SELECT sum(REL_TRADE_AMOUNT) REL_TRADE_AMOUNT FROM ins_tra_interest
        WHERE is_Agreement = '1'
        and STATUS in ('2','6')
        and DELFLAG_ = '1'
        and is_Agreement_Impl in ('4')
        and trade_Agreement_Number = #{agreementNumber}
        UNION
        SELECT sum(REL_TRADE_AMOUNT) REL_TRADE_AMOUNT FROM ins_tra_service
        WHERE is_Agreement = '1'
        and STATUS in ('2','6')
        and DELFLAG_ = '1'
        and is_Agreement_Impl in ('4')
        and trade_Agreement_Number = #{agreementNumber}
        UNION
        SELECT sum(REL_TRADE_AMOUNT) REL_TRADE_AMOUNT FROM ins_tra_business
        WHERE is_Agreement = '1'
        and STATUS in ('2','6')
        and DELFLAG_ = '1'
        and is_Agreement_Impl in ('4')
        and trade_Agreement_Number = #{agreementNumber}
    )AS a
    </select>

    <select id="getIsAgreement" resultMap="baseResultMap">
        SELECT
        a.*
        FROM(
        SELECT pid , contract_date,Contract_Amount, REL_ID,REL_TYPE,REL_NAME,REL_NUMBER,TRAN_TYPE,BUS_TYPE,CONTRACT_NO,REL_TRADE_AMOUNT,trade_Agreement_Number,CREATED_TIME_ FROM ins_tra_interest
        <where>
            is_Agreement = '1'
            and STATUS in ('2','6')
            and DELFLAG_ = '1'
            and is_Agreement_Impl in ('1','2','3')
            <if test="relNumber!=null and relNumber!=''">
                and REL_NUMBER like CONCAT('%', #{relNumber},'%')
            </if>
            <if test="relName!=null and relName!=''">
                and REL_NAME like CONCAT('%',#{relName},'%')
            </if>
        </where>
        UNION
        SELECT pid , contract_date ,Contract_Amount, REL_ID,REL_TYPE,REL_NAME,REL_NUMBER,TRAN_TYPE,BUS_TYPE,CONTRACT_NO,REL_TRADE_AMOUNT,trade_Agreement_Number,CREATED_TIME_ FROM ins_tra_service
        <where>
            is_Agreement = '1'
            and STATUS in ('2','6')
            and DELFLAG_ = '1'
            and is_Agreement_Impl in ('1','2','3')
            <if test="relNumber!=null and relNumber!=''">
                and REL_NUMBER like CONCAT('%', #{relNumber},'%')
            </if>
            <if test="relName!=null and relName!=''">
                and REL_NAME like CONCAT('%',#{relName},'%')
            </if>
        </where>
        UNION
        SELECT pid , contract_date ,Contract_Amount, REL_ID,REL_TYPE,REL_NAME,REL_NUMBER,TRAN_TYPE,BUS_TYPE,CONTRACT_NO,REL_TRADE_AMOUNT,trade_Agreement_Number,CREATED_TIME_ FROM ins_tra_business
        <where>
            is_Agreement = '1'
            and STATUS in ('2','6')
            and DELFLAG_ = '1'
            and is_Agreement_Impl in ('1','2','3')
            <if test="relNumber!=null and relNumber!=''">
                and REL_NUMBER like CONCAT('%', #{relNumber},'%')
            </if>
            <if test="relName!=null and relName!=''">
                and REL_NAME like CONCAT('%',#{relName},'%')
            </if>
        </where>
        )AS a
        ORDER BY a.CREATED_TIME_ DESC
    </select>
</mapper>

