        <result column="up_approval_department" property="upApprovalDepartment" jdbcType="VARCHAR"/>
        <result column="next_approval_department" property="nextApprovalDepartment" jdbcType="VARCHAR"/>
        <result column="up_approval_people" property="upApprovalPeople" jdbcType="VARCHAR"/>
        <result column="next_approval_people" property="nextApprovalPeople" jdbcType="VARCHAR"/>
        <result column="regulator_ybj" property="regulatorYbj" jdbcType="VARCHAR"/>
        <result column="regulator_zjh" property="regulatorZjh" jdbcType="VARCHAR"/>
        <result column="regulator_czb" property="regulatorCzb" jdbcType="VARCHAR"/>
        <result column="regulator_oth1" property="regulatorOth1" jdbcType="VARCHAR"/>
        <result column="regulator_oth2" property="regulatorOth2" jdbcType="VARCHAR"/>
        <result column="is_black" property="isBlack" jdbcType="VARCHAR"/>
        <result column="black_reason" property="blackReason" jdbcType="VARCHAR"/>
        <result column="is_shareholder" property="isShareholder" jdbcType="VARCHAR"/>
        <result column="shareholders_code" property="shareholdersCode" jdbcType="VARCHAR"/>
        <result column="legal_identify_type" property="legalIdentifyType" jdbcType="VARCHAR"/>
        <result column="legal_identify_number" property="legalIdentifyNumber" jdbcType="VARCHAR"/>
        <result column="state_owned" property="stateOwned" jdbcType="VARCHAR"/>
        <result column="open_bank" property="openBank" jdbcType="VARCHAR"/>
        <result column="trade_account" property="tradeAccount" jdbcType="VARCHAR"/>
        <result column="hole_share_amount" property="holeShareAmount" jdbcType="VARCHAR"/>
        <result column="shareholding_proportion" property="shareholdingProportion" jdbcType="VARCHAR"/>
        <result column="frozen_share" property="frozenShare" jdbcType="VARCHAR"/>
        <result column="pledged_share" property="pledgedShare" jdbcType="VARCHAR"/>
        <result column="rel_type" property="relType" jdbcType="VARCHAR"/>
        <result column="TENANT_ID_" property="tenantId" jdbcType="VARCHAR"/>
        <result column="CREATED_BY_ID_" property="createById" jdbcType="VARCHAR"/>
        <result column="CREATED_BY_NAME_" property="createByName" jdbcType="VARCHAR"/>
        <result column="CREATED_TIME_" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="DELFLAG_" property="delflag" jdbcType="VARCHAR"/>
        <result column="DISPLAY_ORDER_" property="displayOrder" jdbcType="INTEGER"/>
        <result column="MODIFIED_BY_ID_" property="modifiedById" jdbcType="VARCHAR"/>
        <result column="MODIFIED_BY_NAME_" property="modifiedByName" jdbcType="VARCHAR"/>
        <result column="MODIFIED_TIME_" property="modifiedTime" jdbcType="TIMESTAMP"/>
        <result column="VERSION_" property="version" jdbcType="INTEGER"/>
        <result column="preset_limit" property="presetLimit" jdbcType="VARCHAR"/>
        <result column="available_limit" property="availableLimit" jdbcType="VARCHAR"/>
        <result column="data_source" property="dataSource" jdbcType="VARCHAR"/>
        <result column="alig_code" property="aligCode" jdbcType="VARCHAR"/>
        <result column="shareholding_proportion" property="shareholdingProportion" jdbcType="VARCHAR"/>
        <result column="vote_proportion" property="voteProportion" jdbcType="VARCHAR"/>
        <result column="warn_leve" property="warnLeve" jdbcType="VARCHAR"/>
    </resultMap>


    <select id="getOrgPsn" parameterType="String" resultType="com.yzj.jep.app.bus.model.RelPsnVo">
        select a.name_ as name,a.identify_type as identifyType,a.identify_number as identifyNumber,
        a.pid as pid,b.pid as relId,b.rel_category as relCategory,b.to_name as relCategorySub,b.shareholding_ratio as
        shareholdingRatio
        from bus_rel_psn as a join
        (select to_pid,to_name,rel_category,pid,shareholding_ratio from bus_rel where from_pid = #{orgid} and from_type
        = 'ORG' and to_type = 'PSN' and (DELFLAG_ = '1')
        UNION select from_pid,from_name,rel_category,pid,shareholding_ratio from bus_rel where to_pid = #{orgid} and
        to_type = 'ORG' and from_type = 'PSN' and DELFLAG_ = '1') as b
        on a.pid = b.to_pid
    </select>
    <select id="getTZOrgPsn" parameterType="String" resultType="com.yzj.jep.app.bus.model.RelOrgVo">
        select a.pid as pid,a.org_name as orgName,a.identify_type as identifyType,a.unisc_code as
        uniscCode,b.rel_category as relCategory,b.rel_category_sub as relCategorySub,b.pid as relId,b.shareholding_ratio
        as shareholdingRatio
        from bus_rel_org as a join
        (select to_pid,to_name as rel_category_sub,rel_category,pid,shareholding_ratio from bus_rel where from_pid =
        #{orgid} and from_type='ORG'
        and to_type='ORG' and DELFLAG_ = '1'
        union
        select from_pid ,from_name as rel_category_sub,rel_category,pid,shareholding_ratio
        from bus_rel where to_pid=#{orgid} and from_type='ORG' and to_type='ORG' and DELFLAG_ = '1') as b
        on a.pid = b.to_pid
    </select>

    <select id="selectList" parameterType="com.yzj.jep.app.bus.model.RelOrg" resultMap="relOrgMap">
        select org.*
        from bus_rel_org as org
        where 1=1
        <if test="orgName != null">
            and org.org_name = #{orgName}
        </if>
        <if test="approvalStatus != null">
            and org.approval_status like #{approvalStatus}
        </if>
        <if test="identifyType != null">
            and org.identify_type like #{identifyType}
        </if>
        <if test="isBlack != null">
            and org.is_black like #{isBlack}
        </if>
        <if test="regulatorOth1 != null">
            and org.regulator_oth1 = #{regulatorOth1}
        </if>
        <if test="uniscCode != null">
            and org.unisc_code = #{uniscCode}
        </if>
        and org.DELFLAG_ = '1'
    </select>

    <select id="selectAffiliateMessageForOrg" parameterType="com.yzj.jep.app.bus.model.RelOrg"
            resultType="java.util.Map">
        select pid,org_name,identify_type,unisc_code,shareholders_code from bus_rel_org
        where 1=1
        <if test="orgName!=null and orgName!=''">
            and org_name= #{orgName}
        </if>
        <if test="identifyType!=null and identifyType!=''">
            and identify_type= #{identifyType}
        </if>
        <if test="uniscCode!=null and uniscCode!=''">
            and unisc_code= #{uniscCode}
        </if>
        <if test="shareholdersCode!=null and shareholdersCode!=''">
            and shareholders_code= #{shareholdersCode}
        </if>
        and DELFLAG_=1
    </select>

    <select id="selectAffiliateMessageForSusOrg" parameterType="com.yzj.jep.app.bus.model.RelOrgSuspect"
            resultType="java.util.Map">
        select pid,org_name,identify_type,unisc_code,shareholders_code from bus_rel_org_suspect
        where 1=1
        <if test="orgName!=null and orgName!=''">
            and org_name= #{orgName}
        </if>
        <if test="identifyType!=null and identifyType!=''">
            and identify_type= #{identifyType}
        </if>
        <if test="uniscCode!=null and uniscCode!=''">
            and unisc_code= #{uniscCode}
        </if>
        <if test="shareholdersCode!=null and shareholdersCode!=''">
            and shareholders_code= #{shareholdersCode}
        </if>
        and DELFLAG_=1
    </select>

    <!--内部人名单管理-->
    <select id="selectListNew" parameterType="com.yzj.jep.app.bus.model.RelOrg" resultMap="relOrgMap">
        select org.*
        from bus_rel_org as org
        where 1=1
        <if test="orgName != null">
            and org.org_name = #{orgName}
        </if>
        <if test="approvalStatus != null">
            and org.approval_status like #{approvalStatus}
        </if>
        <if test="identifyType != null">
            and org.identify_type like #{identifyType}
        </if>
        <if test="isBlack != null">
            and org.is_black like #{isBlack}
        </if>
        <if test="validStatus != null">
            and org.valid_status like #{validStatus}
        </if>
        <if test="regulatorOth1 != null">
            and org.regulator_oth1 = #{regulatorOth1}
        </if>
        <if test="uniscCode != null">
            and org.unisc_code = #{uniscCode}
        </if>
        and org.is_insider = '1'
    </select>
    <select id="selectByEffective" resultType="com.yzj.jep.app.bus.model.RelOrg">
        select * from bus_rel_org where 1=1 and effect_relation = '1' and DELFLAG_= '1'
    </select>

</mapper>

