        <result column="org_name" property="orgName" jdbcType="VARCHAR"/>
        <result column="org_type" property="orgType" jdbcType="VARCHAR"/>
        <result column="domestic_or_foreign" property="domesticOrForeign" jdbcType="VARCHAR"/>
        <result column="identify_type" property="identifyType" jdbcType="VARCHAR"/>
        <result column="unisc_code" property="uniscCode" jdbcType="VARCHAR"/>
        <result column="reg_capital" property="regCapital" jdbcType="REAL"/>
        <result column="reg_capital_currency" property="regCapitalCurrency" jdbcType="VARCHAR"/>
        <result column="business_scope" property="businessScope" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="VARCHAR"/>
        <result column="legal_person" property="legalPerson" jdbcType="VARCHAR"/>
