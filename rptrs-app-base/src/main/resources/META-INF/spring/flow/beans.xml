<!--    </bean>-->

    <bean id="rule" class="com.yzj.jep.app.fPaas.server.RuleServerHandler"/>
    <bean id="trade" class="com.yzj.jep.app.fPaas.server.JudgeImportantTradeHandler"/>
    <bean id="relDistinguish" class="com.yzj.jep.app.fPaas.server.RelDistinguishHandler"/>
    <bean id="getRelTranSubmitFileInfo" class="com.yzj.jep.app.fPaas.server.GetRelTranSubmitFileInfoHandler"/>
