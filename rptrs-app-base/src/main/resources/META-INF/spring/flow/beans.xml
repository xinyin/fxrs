        <property name="channel" ref="gatewaycont"/>
    </bean>
    <bean id="InformationAutoHandler" class="com.yzj.jep.app.fPaas.client.InformationAutoHandler"
          parent="abstractClientFPaaS1Handler">
        <property name="flow" ref="SI_gatewaycontFlow"/>
        <property name="channel" ref="gatewaycont"/>
    </bean>


    <bean id="OAContractGatewayClientHandler" class="com.yzj.jep.app.fPaas.client.OAContractGatewayClientHandler"
