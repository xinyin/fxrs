    <bean id="relDistinguish1" class="com.yzj.jep.app.fPaas.server.RelDistinguishHandler1"/>

    <bean id="traUnSortOut" class="com.yzj.jep.app.fPaas.server.TraUnSortOutHandler"/>

    <bean id="relatedQuery" class="com.yzj.jep.app.fPaas.server.RelatedQueryHandler"/>

    <!--阳光添加  开始-->
    <!--关联方识别接口-->
    <bean id="RelatedPartyIdentification" class="com.yzj.jep.app.fPaas.server.RelatedPartyIdentificationHandler"></bean>
    <!--关联交易合规校验接口-->
<!--    <bean id="RelatedPartyTradeVerifify" class="com.yzj.jep.app.fPaas.server.RelatedPartyTradeVerififyHandler"></bean>-->
    <!--关联交易审批结果查询接口-->
    <bean id="RelatedPartyQueryApproveStatus" class="com.yzj.jep.app.fPaas.server.RelatedPartyQueryApproveStatusHandler"></bean>
    <!--OA用印申请审批信息回调处理接口-->
    <bean id="RelatedPartyResultReceive" class="com.yzj.jep.app.fPaas.server.RelatedPartyResultReceiveHandler"></bean>

    <!-- 关联交易数据获取 T+1-->
    <bean id="getRelTransactions" class="com.yzj.jep.app.fPaas.server.RelatedPartyTransactions"></bean>
    <!-- 关联交易数据获取 实时-->
    <bean id="getRelTransaction" class="com.yzj.jep.app.fPaas.server.RealTimePushOa"></bean>
    <!-- 获取关联方名单表接口-->
    <bean id="getRelList" class="com.yzj.jep.app.fPaas.server.GetRelatedParties"></bean>

    <!-- oa系统,交易废弃时，通过此接口同步废弃关联交易系统对应的交易-->
    <bean id="delRelTransaction" class="com.yzj.jep.app.fPaas.server.DelRelTransaction"></bean>


