    <bean id="DeptsGatewayClientHandler" class="com.yzj.jep.app.fPaas.client.DeptsGatewayClientHandler"
          parent="abstractClientFPaaS1Handler">
        <property name="flow" ref="SI_gatewaycliFlow"/>
        <property name="channel" ref="gatewaycli"/>
    </bean>

    <bean id="StaffGatewayClientHandler" class="com.yzj.jep.app.fPaas.client.StaffGatewayClientHandler"
          parent="abstractClientFPaaS1Handler">
        <property name="flow" ref="SI_gatewaycliFlow"/>
        <property name="channel" ref="gatewaycli"/>
    </bean>

