                <entry key="getRelTransaction" value="getRelTransaction"/>
                <entry key="getRelList" value="getRelList"/>
            </map>
        </property>
    </bean>

    <bean id="confirmServerFPaaS1Handler"
          class="com.fpaas.handl.GatewayServerHandler"
          parent="abstractServerFPaaS1Handler">
        <property name="serviceMapping">
            <map>
                <entry key="demo001" value="server1"/>
                <entry key="rule001" value="rule"/>
                <entry key="trade001" value="trade"/>
                <entry key="relDistinguish" value="relDistinguish"/>
                <entry key="selEtransaction" value="etransaction"/>
                <entry key="ProportionalMonitoring"   value="ProportionalMonitoring"/>
                <entry key="InformationPush" value="InformationPush"/>
                <entry key="confirmRelTranApproval" value="confirmRelTranApproval"/>
                <entry key="voidNotice" value="voidNotice"/>
                <entry key="traUnSortOut" value="traUnSortOut"/>
                <entry key="relatedQuery" value="relatedQuery"/>
                <entry key="getRelTransactions" value="getRelTransactions"/>
                <entry key="getRelTransaction" value="getRelTransaction"/>
                <entry key="getRelList" value="getRelList"/>

            </map>
        </property>
    </bean>

    <bean id="server1" class="com.yzj.jep.app.fPaas.server.GatewayServerHandler"/>
    <bean id="etransaction" class="com.yzj.jep.app.fPaas.server.SelEtransactionHandle"/>

<!--    <bean id="rule" class="com.yzj.jep.app.fPaas.server.RuleServerHandler">-->
