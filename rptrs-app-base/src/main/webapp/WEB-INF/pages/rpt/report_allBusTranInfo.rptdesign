            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">name</property>
                    <property name="nativeName">name</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">identify_number</property>
                    <property name="nativeName">identify_number</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[(
	SELECT
		brp.`name`AS `name`,brp.identify_number AS identify_number
	FROM
		bus_rel_psn brp
	INNER JOIN bus_tra_credit btc ON brp.pid = btc.rel_id
	WHERE
		1 = 1
	AND 2 = 2
	AND 3 = 3
	AND 4 = 4
	AND btc.is_insider = 0
	AND btc.DELFLAG_ = 1
)
UNION ALL
(
	SELECT
		brp.`name`AS `name`,brp.identify_number AS identify_number
	FROM
		bus_rel_psn brp
	INNER JOIN bus_tra_asset bta ON brp.pid = bta.rel_id
	WHERE
		1 = 1
	AND 2 = 2
	AND 3 = 3
	AND 4 = 4
	AND bta.is_insider = 0
	AND bta.DELFLAG_ = 1
)
UNION ALL
(
	SELECT
		brp.`name`AS `name`,brp.identify_number AS identify_number
	FROM
		bus_rel_psn brp
	INNER JOIN bus_tra_service bts ON brp.pid = bts.rel_id
	WHERE
		1 = 1
	AND 2 = 2
	AND 3 = 3
	AND 4 = 4
	AND bts.is_insider = 0
	AND bts.DELFLAG_ = 1
)]]></xml-property>
        </oda-data-set>
    </data-sets>
