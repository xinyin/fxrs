<?xml version="1.0" encoding="UTF-8"?>
<workbook>
    <worksheet name="relPsnSheet">
        <section startRow="0" endRow="0"/>
        <loop startRow="1" endRow="1" items="relPsns" var="PsnInfoVo"
              varType="com.yzj.jep.app.bus.vo.PsnInfoVo">
            <section startRow="1" endRow="1">
                <!--自然人基本信息-->
                <mapping cell="A2">PsnInfoVo.name</mapping><!--姓名-->
                <mapping cell="B2">PsnInfoVo.domesticOrForeign</mapping><!--境内外标识-->
                <mapping cell="C2">PsnInfoVo.identifyType</mapping><!--证件类型-->
                <mapping cell="D2">PsnInfoVo.identifyNumber</mapping><!--证件号码-->
                <mapping cell="E2">PsnInfoVo.sex</mapping><!--性别-->
                <mapping cell="F2">PsnInfoVo.birthdate</mapping><!--出生日期-->
                <mapping cell="G2">PsnInfoVo.mobile</mapping><!--移动电话-->
                <mapping cell="H2">PsnInfoVo.email</mapping><!--邮箱-->
                <mapping cell="I2">PsnInfoVo.workUnits</mapping><!--工作单位-->
                <mapping cell="J2">PsnInfoVo.unitsAddress</mapping><!--单位地址-->
            </section>
            <loopbreakcondition>
                <rowcheck offset="0">
                    <cellcheck offset="0"/>
                </rowcheck>
            </loopbreakcondition>
        </loop>
    </worksheet>
</workbook>
