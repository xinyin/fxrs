    <dependencies>

        <dependency>
            <groupId>com.yzj</groupId>
            <artifactId>jep-sys</artifactId>
        </dependency>

        <dependency>
            <groupId>com.yzj</groupId>
            <artifactId>jep-web-bootstrap</artifactId>
        </dependency>

