<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.yzj</groupId>
    <artifactId>rptrs-app</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.yzj</groupId>
                <artifactId>jep-frame</artifactId>
                <version>0.1.0.INC.FX-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.yzj</groupId>
                <artifactId>rptrs-app-sys</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.yzj</groupId>
                <artifactId>rptrs-app-workflow</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.yzj</groupId>
                <artifactId>rptrs-app-schedule</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.yzj</groupId>
                <artifactId>rptrs-app-rule</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>5.5.8</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.8.1</version>
                    <configuration>
                        <fork>true</fork>
                        <source>1.8</source>
                        <target>1.8</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>2.7</version>
                    <configuration>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <modules>
        <module>rptrs-app-base</module>
        <module>rptrs-app-sys</module>
        <module>rptrs-app-workflow</module>
        <module>rptrs-app-schedule</module>
        <module>rptrs-app-rule</module>
        <module>rptrs-app-neo4j</module>
    </modules>

    <repositories>
        <!-- Required repositories by your develop team -->
        <repository>
            <id>jep-nexus</id>
            <name>yzj Nexus</name>
            <url>http://218.17.55.195:38081/repository/maven-public/</url>
            <layout>default</layout>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
            </snapshots>
        </repository>
    </repositories>
</project>
